abstract;
strict ( 2 );
with hierarchy;

define behavior for ZD_RTR_AP_JournalEntryPostI1 alias JournalEntryPost with control
{
  field ( suppress ) DummyKey;
  field ( mandatory : execute )
  OriginalReferenceDocumentType,
  BusinessTransactionType,
  AccountingDocumentType,
  CompanyCode,
  DocumentDate,
  PostingDate,
  CurrencyCode;

  association _Item;
  association _DebtorItem;
  association _CreditorItem;
  association _ProductTaxItem;
  association _WithHoldingTaxItem;
}

define behavior for ZD_RTR_AP_JournalEntryAPItems alias JournalEntryAPItems with control
{
  field ( suppress ) DummyKey;
  field ( mandatory : execute )
  ReferenceDocumentItem,
  Creditor,
  AmountInTransactionCurrency,
  DebitCreditCode;

  association _Parent;
}

