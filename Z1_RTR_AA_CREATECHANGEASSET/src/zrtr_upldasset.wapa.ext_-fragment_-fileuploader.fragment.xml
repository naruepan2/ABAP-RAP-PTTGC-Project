<core:FragmentDefinition                                                                                                                                                                                                                                       
    xmlns="sap.m"                                                                                                                                                                                                                                              
    xmlns:core="sap.ui.core"                                                                                                                                                                                                                                   
    xmlns:l="sap.ui.layout"                                                                                                                                                                                                                                    
    xmlns:u="sap.ui.unified"                                                                                                                                                                                                                                   
>                                                                                                                                                                                                                                                              
    <Dialog                                                                                                                                                                                                                                                    
        id="idUploadDialog"                                                                                                                                                                                                                                    
        title="{i18n>uploadFile}"                                                                                                                                                                                                                              
        class="sapUiPopupWithPadding"                                                                                                                                                                                                                          
        resizable="true"                                                                                                                                                                                                                                       
        draggable="true"                                                                                                                                                                                                                                       
        horizontalScrolling="false"&nbsp;                                                                                                                                                                                                                      
        verticalScrolling="false"                                                                                                                                                                                                                              
    >                                                                                                                                                                                                                                                          
        <content>                                                                                                                                                                                                                                              
            <VBox id="UploadVbox" height="100%" fitContainer="true">                                                                                                                                                                                           
                <Label id="FileLabel" text="{i18n>lableFile}" labelFor="idMyFileUploader" width="22rem" required="true" wrapping="true"/>                                                                                                                      
				<u:FileUploader                                                                                                                                                                                                                                            
                    id="idMyFileUploader"                                                                                                                                                                                                                      
					name="rawDataFile"                                                                                                                                                                                                                                        
                    placeholder="{i18n>fileUpldVw_placeHolder}"                                                                                                                                                                                                
                    class="sapUiTinyMargin sapUiResponsivePadding"                                                                                                                                                                                             
                    fileType="xlsx"                                                                                                                                                                                                                            
					width="100%"                                                                                                                                                                                                                                              
					multiple="false"&nbsp;                                                                                                                                                                                                                                    
					sameFilenameAllowed="false"                                                                                                                                                                                                                               
					sendXHR="true"&nbsp;                                                                                                                                                                                                                                      
					useMultipart="false"&nbsp;                                                                                                                                                                                                                                
					httpRequestMethod="Put"                                                                                                                                                                                                                                   
                    change="handleDialogUploadOnChange"                                                                                                                                                                                                        
                />                                                                                                                                                                                                                                             
            </VBox>                                                                                                                                                                                                                                            
        </content>                                                                                                                                                                                                                                             
        <beginButton>                                                                                                                                                                                                                                          
            <Button                                                                                                                                                                                                                                            
                id="idUploadFileButton"                                                                                                                                                                                                                        
                class="sapUiTinyMarginBeginEnd sapUiResponsivePadding"                                                                                                                                                                                         
                text="Upload File"                                                                                                                                                                                                                             
                icon="sap-icon://upload-to-cloud"                                                                                                                                                                                                              
                type="Emphasized"                                                                                                                                                                                                                              
                press="handleUploadPress"                                                                                                                                                                                                                      
            />                                                                                                                                                                                                                                                 
        </beginButton>                                                                                                                                                                                                                                         
        <endButton>                                                                                                                                                                                                                                            
            <Button                                                                                                                                                                                                                                            
                id="idCancelFileUploaderButton"                                                                                                                                                                                                                
                text="Cancel"                                                                                                                                                                                                                                  
                icon=""                                                                                                                                                                                                                                        
                press="handleCloseDialog"                                                                                                                                                                                                                      
            />                                                                                                                                                                                                                                                 
        </endButton>                                                                                                                                                                                                                                           
    </Dialog>                                                                                                                                                                                                                                                  
</core:FragmentDefinition>                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               