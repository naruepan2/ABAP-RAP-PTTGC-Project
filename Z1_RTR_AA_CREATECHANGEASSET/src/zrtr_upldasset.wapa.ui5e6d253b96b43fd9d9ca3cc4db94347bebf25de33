sap.ui.define(                                                                                                                                                                                                                                                 
  [                                                                                                                                                                                                                                                            
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "../customLibrary/ODataV4Library",                                                                                                                                                                                                                         
    "../customLibrary/SAPUI5SpreadSheet",                                                                                                                                                                                                                      
  ],                                                                                                                                                                                                                                                           
  function (MessageToast, ODataV4Library, SpreadSheet) {                                                                                                                                                                                                       
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // Custom Action constants Path                                                                                                                                                                                                                            
    const DOWNLOAD_TEMPLATE_ACTION =                                                                                                                                                                                                                           
      "/CreateChangeAsset/com.sap.gateway.srvd.zui_rtr_createchgeasset_o4.v0001.DownloadAssetTemplate";                                                                                                                                                        
    const UPLOAD_FILE_ACTION =                                                                                                                                                                                                                                 
      "/CreateChangeAsset/com.sap.gateway.srvd.zui_rtr_createchgeasset_o4.v0001.UploadAssetFileContent";                                                                                                                                                       
    const DELETE_ALL_RECORDS_ACTION =                                                                                                                                                                                                                          
      "/CreateChangeAsset/com.sap.gateway.srvd.zui_rtr_createchgeasset_o4.v0001.RefreshCreateChangeAssetRecord";                                                                                                                                               
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
      /**                                                                                                                                                                                                                                                      
       * Generated event handler.                                                                                                                                                                                                                              
       *                                                                                                                                                                                                                                                       
       * @param oContext the context of the page on which the event was fired. `undefined` for list report page.                                                                                                                                               
       * @param aSelectedContexts the selected contexts of the table rows.                                                                                                                                                                                     
       */                                                                                                                                                                                                                                                      
      DownloadAssetSpreadsheetTemplate: async function (                                                                                                                                                                                                       
        oContext,                                                                                                                                                                                                                                              
        aSelectedContexts                                                                                                                                                                                                                                      
      ) {                                                                                                                                                                                                                                                      
        const oView = this.getEditFlow().getView();                                                                                                                                                                                                            
        const oModel = oContext?.getModel() || oView.getModel();                                                                                                                                                                                               
        const sActionName = DOWNLOAD_TEMPLATE_ACTION.substring(1);                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
          oView.setBusy(true);                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
          const aResults = await ODataV4Library.executeActionForContexts(                                                                                                                                                                                      
            aSelectedContexts,                                                                                                                                                                                                                                 
            sActionName,                                                                                                                                                                                                                                       
            oModel,                                                                                                                                                                                                                                            
            null,                                                                                                                                                                                                                                              
            "true"                                                                                                                                                                                                                                             
          );                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          SpreadSheet.ExportSpreadSheet(                                                                                                                                                                                                                       
            aResults.AssetFileName,                                                                                                                                                                                                                            
            aResults.AssetFileContent,                                                                                                                                                                                                                         
            aResults.AssetMimeType                                                                                                                                                                                                                             
          );                                                                                                                                                                                                                                                   
        } catch (oError) {                                                                                                                                                                                                                                     
          console.error("Excel template download failed:", oError);                                                                                                                                                                                            
        } finally {                                                                                                                                                                                                                                            
          oView.setBusy(false);                                                                                                                                                                                                                                
          ODataV4Library.clearModelCache();                                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
      UploadAssetSpreadsheetTemplate: async function (                                                                                                                                                                                                         
        oContext,                                                                                                                                                                                                                                              
        aSelectedContexts                                                                                                                                                                                                                                      
      ) {                                                                                                                                                                                                                                                      
        const oView = this.getEditFlow().getView();                                                                                                                                                                                                            
        const oModel = oContext?.getModel() || oView.getModel();                                                                                                                                                                                               
        const sActionName = UPLOAD_FILE_ACTION.substring(1);                                                                                                                                                                                                   
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
          SpreadSheet.openExcelUploadDialog({                                                                                                                                                                                                                  
            fragmentPath:                                                                                                                                                                                                                                      
            "zpttgc.rtr.createchangeasstermaster.ext.fragment.FileUploader",                                                                                                                                                                                   
            controller: this,                                                                                                                                                                                                                                  
            model: oModel,                                                                                                                                                                                                                                     
            actionName: sActionName,                                                                                                                                                                                                                           
            odataParameters: {},                                                                                                                                                                                                                               
            fileContentParameterName: "AssetFileContent",                                                                                                                                                                                                      
            onSuccess: (aResults) => {&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                     
              // Show success message                                                                                                                                                                                                                          
              MessageToast.show(aResults?.Message || "Upload completed successfully");                                                                                                                                                                         
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                           
              // Refresh table or do other actions                                                                                                                                                                                                             
              //oModel.refresh();                                                                                                                                                                                                                              
              //this.refresh();                                                                                                                                                                                                                                
            },                                                                                                                                                                                                                                                 
            onError: (oError) => {                                                                                                                                                                                                                             
              // Callback with error                                                                                                                                                                                                                           
              //console.error("Upload failed! Error:", oError);                                                                                                                                                                                                
              //console.error("Call stack:", new Error().stack);                                                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
          });                                                                                                                                                                                                                                                  
        } catch (oError) {                                                                                                                                                                                                                                     
          console.error("Failed to open upload dialog:", oError);                                                                                                                                                                                              
        } finally {                                                                                                                                                                                                                                            
          ODataV4Library.clearModelCache();                                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
      DeleteAllOfAssetRecords: async function (oContext, aSelectedContexts) {                                                                                                                                                                                  
        const oView = this.getEditFlow().getView();                                                                                                                                                                                                            
        const oModel = oContext?.getModel() || oView.getModel();                                                                                                                                                                                               
        const sActionName = DELETE_ALL_RECORDS_ACTION.substring(1);                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
          oView.setBusy(true);                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
          const aResults = await ODataV4Library.executeActionForContexts(                                                                                                                                                                                      
            aSelectedContexts,                                                                                                                                                                                                                                 
            sActionName,                                                                                                                                                                                                                                       
            oModel,                                                                                                                                                                                                                                            
            null,                                                                                                                                                                                                                                              
            "true"                                                                                                                                                                                                                                             
          );                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          MessageToast.show(                                                                                                                                                                                                                                   
            aResults?.Message || "Operation completed successfully."                                                                                                                                                                                           
          );                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          oModel.refresh();                                                                                                                                                                                                                                    
          this.refresh();                                                                                                                                                                                                                                      
        } catch (oError) {                                                                                                                                                                                                                                     
          console.error("Delete operation failed:", oError);                                                                                                                                                                                                   
        } finally {                                                                                                                                                                                                                                            
          oView.setBusy(false);                                                                                                                                                                                                                                
          ODataV4Library.clearModelCache();                                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
      }                                                                                                                                                                                                                                                        
    };                                                                                                                                                                                                                                                         
  }                                                                                                                                                                                                                                                            
);                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               