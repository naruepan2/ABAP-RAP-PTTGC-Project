sap.ui.define(                                                                                                                                                                                                                                                 
  [                                                                                                                                                                                                                                                            
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/ui/model/odata/v2/ODataModel",                                                                                                                                                                                                                        
  ],                                                                                                                                                                                                                                                           
  function (MessageBox, ODataModelV2) {                                                                                                                                                                                                                        
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    const oModelCache = new Map();                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
      /**                                                                                                                                                                                                                                                      
       * Executes an OData V2 operation (function import, CRUD) for one or more contexts or as a static (unbound) action.                                                                                                                                      
       * @example                                                                                                                                                                                                                                              
       * // How to use this method from an external controller:                                                                                                                                                                                                
       * // 1. Import the library in your controller's definition:                                                                                                                                                                                             
       * //    sap.ui.define([                                                                                                                                                                                                                                 
       * //        "sap/ui/core/mvc/Controller",                                                                                                                                                                                                               
       * //        "../customLibrary/ODataV2Library" // Adjust path as needed                                                                                                                                                                                  
       * //    ], function (Controller, ODataV2Library) {                                                                                                                                                                                                      
       * //        "use strict";                                                                                                                                                                                                                               
       * //        return Controller.extend("my.app.controller.MyController", {                                                                                                                                                                                
       * //            onSomeAction: async function () {                                                                                                                                                                                                       
       * //                const oModel = this.getView().getModel();                                                                                                                                                                                           
       * //                const aContexts = this.byId("myTable").getSelectedContexts();                                                                                                                                                                       
       * //                                                                                                                                                                                                                                                    
       * //                // Example for a function import                                                                                                                                                                                                    
       * //                await ODataV2Library.executeActionForContexts({                                                                                                                                                                                     
       * //                    aContexts: aContexts,                                                                                                                                                                                                           
       * //                    sPath: "YourFunctionImportName",                                                                                                                                                                                                
       * //                    sMethod: 'callFunction',                                                                                                                                                                                                        
       * //                    oModel: oModel,                                                                                                                                                                                                                 
       * //                    oPayload: { Param1: "Value1" },                                                                                                                                                                                                 
       * //                    bUseSubmitBatch: true                                                                                                                                                                                                           
       * //                });                                                                                                                                                                                                                                 
       * //                                                                                                                                                                                                                                                    
       * //                // Example for a create operation                                                                                                                                                                                                   
       * //                await ODataV2Library.create(oModel, "/YourEntitySet", { Property1: "NewValue" });                                                                                                                                                   
       * //                                                                                                                                                                                                                                                    
       * //                // Example for a batch of operations                                                                                                                                                                                                
       * //                ODataV2Library.update(oModel, "/YourEntitySet('key')", { Property1: "UpdatedValue" });                                                                                                                                              
       * //                ODataV2Library.remove(oModel, "/YourEntitySet('key2')");                                                                                                                                                                            
       * //                await ODataV2Library.submitBatch(oModel);                                                                                                                                                                                           
       * //            }                                                                                                                                                                                                                                       
       * //        });                                                                                                                                                                                                                                         
       * //    });                                                                                                                                                                                                                                             
       *                                                                                                                                                                                                                                                       
       * @param {object} mParameters - The parameters for the operation.                                                                                                                                                                                       
       * @param {sap.ui.model.Context[]} [mParameters.aContexts=null] - Array of contexts. Pass null for static actions.                                                                                                                                       
       * @param {string} mParameters.sPath - The path for the operation (e.g., function import name, entity set path).                                                                                                                                         
       * @param {string} mParameters.sMethod - The HTTP method or CRUD operation type ('callFunction', 'create', 'read', 'update', 'remove').                                                                                                                  
       * @param {sap.ui.model.odata.v2.ODataModel} mParameters.oModel - The OData V2 model.                                                                                                                                                                    
       * @param {object} [mParameters.oPayload=null] - The payload for the operation.                                                                                                                                                                          
       * @param {boolean} [mParameters.bUseSubmitBatch=false] - Whether to use submitBatch for the request.                                                                                                                                                    
       * @returns {Promise<any[]|any>} A promise that resolves with the results.                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      executeActionForContexts: async function (mParameters) {                                                                                                                                                                                                 
        const { aContexts, sPath, sMethod, oModel, oPayload, bUseSubmitBatch } = mParameters;                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        const oM = oModel || (aContexts && aContexts.length > 0 && aContexts[0].getModel());                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        if (!oM) {                                                                                                                                                                                                                                             
          const sError = "OData model could not be determined for the action.";                                                                                                                                                                                
          MessageBox.error(sError);                                                                                                                                                                                                                            
          throw new Error(sError);                                                                                                                                                                                                                             
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (!aContexts || aContexts.length === 0) {                                                                                                                                                                                                            
            return this._executeStatic(sPath, sMethod, oM, oPayload);                                                                                                                                                                                          
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return this._execute(aContexts, sPath, sMethod, oM, oPayload, bUseSubmitBatch);                                                                                                                                                                        
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      create: function(oModel, sPath, oData) {                                                                                                                                                                                                                 
        return this.executeActionForContexts({ sPath: sPath, sMethod: 'create', oModel: oModel, oPayload: oData });                                                                                                                                            
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      read: function(oModel, sPath, oUrlParameters) {                                                                                                                                                                                                          
        return this.executeActionForContexts({ sPath: sPath, sMethod: 'read', oModel: oModel, oPayload: oUrlParameters });                                                                                                                                     
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      update: function(oModel, sPath, oData) {                                                                                                                                                                                                                 
        return this.executeActionForContexts({ sPath: sPath, sMethod: 'update', oModel: oModel, oPayload: oData });                                                                                                                                            
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      remove: function(oModel, sPath) {                                                                                                                                                                                                                        
        return this.executeActionForContexts({ sPath: sPath, sMethod: 'remove', oModel: oModel });                                                                                                                                                             
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      submitBatch: function (oModel) {                                                                                                                                                                                                                         
        return new Promise((resolve, reject) => {                                                                                                                                                                                                              
          oModel.submitChanges({                                                                                                                                                                                                                               
            success: (oData) => resolve(oData),                                                                                                                                                                                                                
            error: (oError) => reject(oError),                                                                                                                                                                                                                 
          });                                                                                                                                                                                                                                                  
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _execute: async function (aContexts, sPath, sMethod, oModel, oPayload, bBatch) {                                                                                                                                                                         
        const aPromises = aContexts.map((oContext) => {                                                                                                                                                                                                        
            return new Promise((resolve, reject) => {                                                                                                                                                                                                          
                const mParameters = {                                                                                                                                                                                                                          
                    success: (oData) => resolve(oData),                                                                                                                                                                                                        
                    error: (oError) => reject(oError)                                                                                                                                                                                                          
                };                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                if (sMethod === 'read') {                                                                                                                                                                                                                      
                    mParameters.urlParameters = oPayload;                                                                                                                                                                                                      
                    oModel[sMethod](oContext.getPath(), mParameters);                                                                                                                                                                                          
                } else if (sMethod === 'callFunction') {                                                                                                                                                                                                       
                    const oMeta = oModel.getServiceMetadata();                                                                                                                                                                                                 
                    const oObject = oContext.getObject();                                                                                                                                                                                                      
                    const sContextPath = oContext.getPath();                                                                                                                                                                                                   
                    const sEntitySet = sContextPath.substring(1, sContextPath.indexOf("("));                                                                                                                                                                   
                    const oEntitySet = oMeta.data.schema.entityContainer[0].entitySet.find(e => e.name === sEntitySet);                                                                                                                                        
                    const oEntityType = oMeta.data.schema.entityType.find(e => e.name === oEntitySet.entityType.substring(oEntitySet.entityType.lastIndexOf(".") + 1));                                                                                        
                    const aKeys = oEntityType.key.propertyRef.map(k => k.name);                                                                                                                                                                                
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                               
                    const oUrlParameters = { ...oPayload };                                                                                                                                                                                                    
                    aKeys.forEach(sKey => {                                                                                                                                                                                                                    
                        oUrlParameters[sKey] = oObject[sKey];                                                                                                                                                                                                  
                    });                                                                                                                                                                                                                                        
                    mParameters.urlParameters = oUrlParameters;                                                                                                                                                                                                
                    oModel.callFunction(sPath, mParameters);                                                                                                                                                                                                   
                } else {                                                                                                                                                                                                                                       
                    const sFullPath = oContext.getPath() + (sPath.startsWith('/') ? '' : '/') + sPath;                                                                                                                                                         
                    oModel[sMethod](sFullPath, oPayload, mParameters);                                                                                                                                                                                         
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        if (bBatch) {                                                                                                                                                                                                                                          
            return this.submitBatch(oModel);                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return Promise.all(aPromises);                                                                                                                                                                                                                         
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _executeStatic: function (sPath, sMethod, oModel, oPayload) {                                                                                                                                                                                            
        return new Promise((resolve, reject) => {                                                                                                                                                                                                              
            const mParameters = {                                                                                                                                                                                                                              
                success: (oData) => resolve(oData),                                                                                                                                                                                                            
                error: (oError) => reject(oError)                                                                                                                                                                                                              
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            if (sMethod === 'read' || sMethod === 'callFunction') {                                                                                                                                                                                            
                mParameters.urlParameters = oPayload;                                                                                                                                                                                                          
                oModel[sMethod](sPath, mParameters);                                                                                                                                                                                                           
            } else {                                                                                                                                                                                                                                           
                oModel[sMethod](sPath, oPayload, mParameters);                                                                                                                                                                                                 
            }                                                                                                                                                                                                                                                  
        });                                                                                                                                                                                                                                                    
      }                                                                                                                                                                                                                                                        
    };                                                                                                                                                                                                                                                         
  }                                                                                                                                                                                                                                                            
);                                                                                                                                                                                                                                                             