/**                                                                                                                                                                                                                                                            
 * PDFUtilsLibrary - Display and merge PDF documents in new browser tab                                                                                                                                                                                        
 *                                                                                                                                                                                                                                                             
 * NO PREREQUISITES NEEDED - pdf-lib is loaded automatically when merging PDFs                                                                                                                                                                                 
 *                                                                                                                                                                                                                                                             
 * IMPORT IN CONTROLLER:                                                                                                                                                                                                                                       
 * sap.ui.define(["../customLibrary/PDFUtilsLibrary"], function(PDFUtilsLibrary) { ... });                                                                                                                                                                     
 *                                                                                                                                                                                                                                                             
 * USAGE:                                                                                                                                                                                                                                                      
 * - Single PDF: await PDFUtilsLibrary.displayPdf("base64string");                                                                                                                                                                                             
 * - Multiple PDFs (auto-merge): await PDFUtilsLibrary.displayPdf(["pdf1", "pdf2", "pdf3"]);                                                                                                                                                                   
 * - From OData: await PDFUtilsLibrary.displayPdf(oResult.value);                                                                                                                                                                                              
 */                                                                                                                                                                                                                                                            
sap.ui.define(                                                                                                                                                                                                                                                 
  ["sap/m/MessageBox", "sap/m/MessageToast"],                                                                                                                                                                                                                  
  function (MessageBox, MessageToast) {                                                                                                                                                                                                                        
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    const aPdfUrls = [];                                                                                                                                                                                                                                       
    let pdfLib;                                                                                                                                                                                                                                                
    let pdfLibLoading = false;                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
    const PDFUtilsLibrary = {                                                                                                                                                                                                                                  
      /**                                                                                                                                                                                                                                                      
       * Opens Base64 encoded PDF(s) in a new browser tab.                                                                                                                                                                                                     
       * Single PDF → displays directly | Multiple PDFs → merges then displays                                                                                                                                                                                 
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // Example 1: Single PDF from OData action                                                                                                                                                                                                            
       * onViewPdfPress: async function() {                                                                                                                                                                                                                    
       *     const oModel = this.getView().getModel();                                                                                                                                                                                                         
       *     const oContext = this.getView().getBindingContext();                                                                                                                                                                                              
       *     const oResult = await ODataV4Library.executeActionForContexts({                                                                                                                                                                                   
       *         aContexts: [oContext],                                                                                                                                                                                                                        
       *         sPath: "GeneratePdfReport",                                                                                                                                                                                                                   
       *         oModel: oModel                                                                                                                                                                                                                                
       *     });                                                                                                                                                                                                                                               
       *     if (oResult?.value) {                                                                                                                                                                                                                             
       *         await PDFUtilsLibrary.displayPdf(oResult.value);                                                                                                                                                                                              
       *     }                                                                                                                                                                                                                                                 
       * }                                                                                                                                                                                                                                                     
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // Example 2: Multiple PDFs from selected table items (auto-merge)                                                                                                                                                                                    
       * onGenerateMergedPdfPress: async function() {                                                                                                                                                                                                          
       *     const oTable = this.byId("myTable");                                                                                                                                                                                                              
       *     const aContexts = oTable.getSelectedContexts();                                                                                                                                                                                                   
       *     const oModel = this.getView().getModel();                                                                                                                                                                                                         
       *                                                                                                                                                                                                                                                       
       *     const aResults = await Promise.allSettled(                                                                                                                                                                                                        
       *         aContexts.map(ctx => ODataV4Library.executeActionForContexts({                                                                                                                                                                                
       *             aContexts: [ctx],                                                                                                                                                                                                                         
       *             sPath: "GeneratePdfReport",                                                                                                                                                                                                               
       *             oModel: oModel                                                                                                                                                                                                                            
       *         }))                                                                                                                                                                                                                                           
       *     );                                                                                                                                                                                                                                                
       *                                                                                                                                                                                                                                                       
       *     const aPdfData = aResults                                                                                                                                                                                                                         
       *         .filter(r => r.status === "fulfilled" && r.value?.value)                                                                                                                                                                                      
       *         .map(r => r.value.value);                                                                                                                                                                                                                     
       *                                                                                                                                                                                                                                                       
       *     if (aPdfData.length > 0) {                                                                                                                                                                                                                        
       *         await PDFUtilsLibrary.displayPdf(aPdfData);                                                                                                                                                                                                   
       *     }                                                                                                                                                                                                                                                 
       * }                                                                                                                                                                                                                                                     
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // Example 3: Direct Base64 strings                                                                                                                                                                                                                   
       * await PDFUtilsLibrary.displayPdf("JVBERi0xLjQKJ..."); // Single                                                                                                                                                                                       
       * await PDFUtilsLibrary.displayPdf(["pdf1base64", "pdf2base64"]); // Multiple (merged)                                                                                                                                                                  
       *                                                                                                                                                                                                                                                       
       * @param {string|string[]} vBase64PdfData - Base64 string or array of Base64 strings                                                                                                                                                                    
       * @returns {Promise<void>}                                                                                                                                                                                                                              
       * @public                                                                                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      displayPdf: async function (vBase64PdfData) {                                                                                                                                                                                                            
        const aPdfData = Array.isArray(vBase64PdfData)                                                                                                                                                                                                         
          ? vBase64PdfData                                                                                                                                                                                                                                     
          : [vBase64PdfData];                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        if (                                                                                                                                                                                                                                                   
          !aPdfData.length ||                                                                                                                                                                                                                                  
          aPdfData.some((s) => !s || typeof s !== "string")                                                                                                                                                                                                    
        ) {                                                                                                                                                                                                                                                    
          MessageBox.error("Invalid PDF data provided.");                                                                                                                                                                                                      
          return;                                                                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
          this._cleanupPdfUrls();                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
          let sFinalPdfBase64;                                                                                                                                                                                                                                 
          if (aPdfData.length > 1) {                                                                                                                                                                                                                           
            await this._loadPdfLib();                                                                                                                                                                                                                          
            sFinalPdfBase64 = await this._mergePDFs(aPdfData);                                                                                                                                                                                                 
          } else {                                                                                                                                                                                                                                             
            sFinalPdfBase64 = aPdfData[0];                                                                                                                                                                                                                     
          }                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
          this._openPdfInNewTab(sFinalPdfBase64);                                                                                                                                                                                                              
          MessageToast.show("PDF opened successfully.");                                                                                                                                                                                                       
        } catch (error) {                                                                                                                                                                                                                                      
          console.error("Error displaying PDF:", error);                                                                                                                                                                                                       
          MessageBox.error("Failed to display PDF: " + error.message);                                                                                                                                                                                         
        } finally {                                                                                                                                                                                                                                            
          // Clear references for garbage collection                                                                                                                                                                                                           
          aPdfData.length = 0;                                                                                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _loadPdfLib: function () {                                                                                                                                                                                                                               
        return new Promise((resolve, reject) => {                                                                                                                                                                                                              
          if (window.PDFLib) {                                                                                                                                                                                                                                 
            pdfLib = window.PDFLib;                                                                                                                                                                                                                            
            resolve();                                                                                                                                                                                                                                         
            return;                                                                                                                                                                                                                                            
          }                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
          if (pdfLibLoading) {                                                                                                                                                                                                                                 
            let attempts = 0;                                                                                                                                                                                                                                  
            const maxAttempts = 100; // 10 seconds timeout                                                                                                                                                                                                     
            const checkInterval = setInterval(() => {                                                                                                                                                                                                          
              if (window.PDFLib) {                                                                                                                                                                                                                             
                clearInterval(checkInterval);                                                                                                                                                                                                                  
                pdfLib = window.PDFLib;                                                                                                                                                                                                                        
                resolve();                                                                                                                                                                                                                                     
              } else if (++attempts >= maxAttempts) {                                                                                                                                                                                                          
                clearInterval(checkInterval);                                                                                                                                                                                                                  
                reject(new Error("Timeout waiting for pdf-lib to load"));                                                                                                                                                                                      
              }                                                                                                                                                                                                                                                
            }, 100);                                                                                                                                                                                                                                           
            return;                                                                                                                                                                                                                                            
          }                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
          pdfLibLoading = true;                                                                                                                                                                                                                                
          const script = document.createElement("script");                                                                                                                                                                                                     
          // Can be check latest version: https://www.jsdelivr.com/package/npm/pdf-lib#id-features                                                                                                                                                             
          script.src = "https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js";                                                                                                                                                                      
          script.onload = () => {                                                                                                                                                                                                                              
            pdfLib = window.PDFLib;                                                                                                                                                                                                                            
            pdfLibLoading = false;                                                                                                                                                                                                                             
            resolve();                                                                                                                                                                                                                                         
          };                                                                                                                                                                                                                                                   
          script.onerror = () => {                                                                                                                                                                                                                             
            pdfLibLoading = false;                                                                                                                                                                                                                             
            reject(new Error("Failed to load pdf-lib from CDN"));                                                                                                                                                                                              
          };                                                                                                                                                                                                                                                   
          document.head.appendChild(script);                                                                                                                                                                                                                   
        });                                                                                                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _mergePDFs: async function (aBase64Pdfs) {                                                                                                                                                                                                               
        const oMergedPdf = await pdfLib.PDFDocument.create();                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        for (let i = 0; i < aBase64Pdfs.length; i++) {                                                                                                                                                                                                         
          try {                                                                                                                                                                                                                                                
            const aUint8Array = this._base64ToUint8Array(aBase64Pdfs[i]);                                                                                                                                                                                      
            const oPdf = await pdfLib.PDFDocument.load(aUint8Array);                                                                                                                                                                                           
            const aCopiedPages = await oMergedPdf.copyPages(                                                                                                                                                                                                   
              oPdf,                                                                                                                                                                                                                                            
              oPdf.getPageIndices()                                                                                                                                                                                                                            
            );                                                                                                                                                                                                                                                 
            aCopiedPages.forEach((oPage) => oMergedPdf.addPage(oPage));                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            // Memory cleanup                                                                                                                                                                                                                                  
            aUint8Array.fill(0);                                                                                                                                                                                                                               
          } catch (error) {                                                                                                                                                                                                                                    
            throw new Error(`Failed to merge PDF #${i + 1}: ${error.message}`);                                                                                                                                                                                
          }                                                                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return await oMergedPdf.saveAsBase64();                                                                                                                                                                                                                
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _openPdfInNewTab: function (sBase64Pdf) {                                                                                                                                                                                                                
        const aUint8Array = this._base64ToUint8Array(sBase64Pdf);                                                                                                                                                                                              
        const oBlob = new Blob([aUint8Array], { type: "application/pdf" });                                                                                                                                                                                    
        const sUrl = URL.createObjectURL(oBlob);                                                                                                                                                                                                               
        aPdfUrls.push(sUrl);                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        const oWindow = window.open(sUrl, "_blank");                                                                                                                                                                                                           
        if (!oWindow) {                                                                                                                                                                                                                                        
          MessageBox.warning("Please allow pop-ups to view the PDF.");                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        // Memory cleanup                                                                                                                                                                                                                                      
        aUint8Array.fill(0);                                                                                                                                                                                                                                   
        setTimeout(() => this._cleanupPdfUrls(), 5000);                                                                                                                                                                                                        
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _base64ToUint8Array: function (sBase64) {                                                                                                                                                                                                                
        const sBinaryString = atob(sBase64);                                                                                                                                                                                                                   
        const iLen = sBinaryString.length;                                                                                                                                                                                                                     
        const aBytes = new Uint8Array(iLen);                                                                                                                                                                                                                   
        for (let i = 0; i < iLen; i++) {                                                                                                                                                                                                                       
          aBytes[i] = sBinaryString.charCodeAt(i);                                                                                                                                                                                                             
        }                                                                                                                                                                                                                                                      
        return aBytes;                                                                                                                                                                                                                                         
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      _cleanupPdfUrls: function () {                                                                                                                                                                                                                           
        aPdfUrls.forEach((sUrl) => {                                                                                                                                                                                                                           
          try {                                                                                                                                                                                                                                                
            URL.revokeObjectURL(sUrl);                                                                                                                                                                                                                         
          } catch (e) {                                                                                                                                                                                                                                        
            console.warn("Failed to revoke URL:", e);                                                                                                                                                                                                          
          }                                                                                                                                                                                                                                                    
        });                                                                                                                                                                                                                                                    
        aPdfUrls.length = 0;                                                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    return PDFUtilsLibrary;                                                                                                                                                                                                                                    
  }                                                                                                                                                                                                                                                            
);                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               