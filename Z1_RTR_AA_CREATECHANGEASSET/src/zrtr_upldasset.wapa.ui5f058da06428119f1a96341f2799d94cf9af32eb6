sap.ui.define(                                                                                                                                                                                                                                                 
  ["sap/m/MessageToast", "sap/m/MessageBox"],                                                                                                                                                                                                                  
  function (MessageToast, MessageBox) {                                                                                                                                                                                                                        
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // Performance caching                                                                                                                                                                                                                                     
    const oTokenCache = new Map();                                                                                                                                                                                                                             
    const TOKEN_CACHE_TTL = 300000; // 5 minutes                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
      /**                                                                                                                                                                                                                                                      
       * Executes a custom OData action for multiple selected items using a manual batch request.                                                                                                                                                              
       * Can also execute a static (unbound) action if bIsStaticAction is true.                                                                                                                                                                                
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // In your controller extension, calling a context-bound (batch) action on selected items:                                                                                                                                                            
       * const aResults = await JQueryAjaxLibrary.executeCustomAction(                                                                                                                                                                                         
       *     oModel.getServiceUrl(),                                                                                                                                                                                                                           
       *     "/MyBoundAction",                                                                                                                                                                                                                                 
       *     aSelectedContexts,                                                                                                                                                                                                                                
       *     { reason: "User-triggered" } // Optional parameters                                                                                                                                                                                               
       * );                                                                                                                                                                                                                                                    
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // In your controller extension, calling a static (unbound) action:                                                                                                                                                                                   
       * const oResult = await JQueryAjaxLibrary.executeCustomAction(                                                                                                                                                                                          
       *     oModel.getServiceUrl(),                                                                                                                                                                                                                           
       *     "/MyStaticAction",                                                                                                                                                                                                                                
       *     null, // No contexts needed for static actions                                                                                                                                                                                                    
       *     { fileType: "PDF" }, // Optional parameters                                                                                                                                                                                                       
       *     true // Mark as static action                                                                                                                                                                                                                     
       * );                                                                                                                                                                                                                                                    
       *                                                                                                                                                                                                                                                       
       * @param {string} sServiceUrl - The root URL of the OData service.                                                                                                                                                                                      
       * @param {string} sActionPath - The path to the OData action (e.g., "/MyAction").                                                                                                                                                                       
       * @param {sap.ui.model.odata.v4.Context[] | null} aContexts - An array of contexts for the items to be processed. Pass null for static actions.                                                                                                         
       * @param {object} [oParameters=null] - An object containing the parameters for the action.                                                                                                                                                              
       * @param {boolean} [bIsStaticAction=false] - Set to true if the action is a static (unbound) action.                                                                                                                                                    
       * @returns {Promise<object[]|object>} A promise that resolves with an array of result objects for batch, or a single object for static actions.                                                                                                         
       */                                                                                                                                                                                                                                                      
      executeCustomAction: async function (                                                                                                                                                                                                                    
        sServiceUrl,                                                                                                                                                                                                                                           
        sActionPath,                                                                                                                                                                                                                                           
        aContexts,                                                                                                                                                                                                                                             
        oParameters,                                                                                                                                                                                                                                           
        bIsStaticAction                                                                                                                                                                                                                                        
      ) {                                                                                                                                                                                                                                                      
        try {                                                                                                                                                                                                                                                  
          const csrfToken = await this._fetchCsrfTokenCached(sServiceUrl);                                                                                                                                                                                     
          const sNormalizedActionPath = sActionPath.startsWith("/")                                                                                                                                                                                            
            ? sActionPath                                                                                                                                                                                                                                      
            : `/${sActionPath}`;                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
          // Handle static (unbound) actions                                                                                                                                                                                                                   
          if (bIsStaticAction) {                                                                                                                                                                                                                               
            return await this._executeStaticActionRequest(                                                                                                                                                                                                     
              sServiceUrl,                                                                                                                                                                                                                                     
              sNormalizedActionPath,                                                                                                                                                                                                                           
              oParameters,                                                                                                                                                                                                                                     
              csrfToken                                                                                                                                                                                                                                        
            );                                                                                                                                                                                                                                                 
          }                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
          // Handle context-bound (batch) actions                                                                                                                                                                                                              
          const aSelectedContexts = aContexts;                                                                                                                                                                                                                 
          // Early exit if there's nothing to process                                                                                                                                                                                                          
          if (!aSelectedContexts || aSelectedContexts.length === 0) {                                                                                                                                                                                          
            MessageToast.show("Please select at least one item to proceed.");                                                                                                                                                                                  
            return [];                                                                                                                                                                                                                                         
          }                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
          // Build action URLs for each selected context                                                                                                                                                                                                       
          const aActionUrls = aSelectedContexts.map((oContext) => {                                                                                                                                                                                            
            const sContextPath = oContext.getPath().substring(1);                                                                                                                                                                                              
            return `${sServiceUrl}${sContextPath}${sNormalizedActionPath}`;                                                                                                                                                                                    
          });                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
          // Create batch payload and execute request                                                                                                                                                                                                          
          const oBatchData = this._createBatchPayload(                                                                                                                                                                                                         
            aActionUrls,                                                                                                                                                                                                                                       
            oParameters,                                                                                                                                                                                                                                       
            csrfToken                                                                                                                                                                                                                                          
          );                                                                                                                                                                                                                                                   
          const sResponseText = await this._executeBatchRequest(                                                                                                                                                                                               
            sServiceUrl,                                                                                                                                                                                                                                       
            oBatchData                                                                                                                                                                                                                                         
          );                                                                                                                                                                                                                                                   
          const aSettledResults = this._parseBatchResponse(sResponseText);                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
          return aSettledResults;                                                                                                                                                                                                                              
        } catch (oError) {                                                                                                                                                                                                                                     
          const sMessage =                                                                                                                                                                                                                                     
            typeof oError === "string"                                                                                                                                                                                                                         
              ? oError                                                                                                                                                                                                                                         
              : oError.message || "An unknown error occurred.";                                                                                                                                                                                                
          MessageBox.error(sMessage);                                                                                                                                                                                                                          
          throw oError; // Re-throw to allow caller to handle                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Creates the multipart/mixed payload for an OData batch request.                                                                                                                                                                                       
       * @private                                                                                                                                                                                                                                              
       * @param {string[]} aUrls - An array of full URLs for the actions.                                                                                                                                                                                      
       * @param {object} oParameters - The parameters for the action.                                                                                                                                                                                          
       * @param {string} sCsrfToken - The CSRF token for the request.                                                                                                                                                                                          
       * @returns {{payload: string, batchId: string, csrfToken: string}} An object containing the payload, batch ID, and token.                                                                                                                               
       */                                                                                                                                                                                                                                                      
      _createBatchPayload: function (aUrls, oParameters, sCsrfToken) {                                                                                                                                                                                         
        const sBatchId = `batch_id-${Date.now()}-${Math.floor(                                                                                                                                                                                                 
          Math.random() * 1000                                                                                                                                                                                                                                 
        )}`;                                                                                                                                                                                                                                                   
        const sChangesetId = `changeset_id-${Date.now()}-${Math.floor(                                                                                                                                                                                         
          Math.random() * 1000                                                                                                                                                                                                                                 
        )}`;                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        // Use array for better performance with large batches                                                                                                                                                                                                 
        const aPayloadParts = [                                                                                                                                                                                                                                
          `--${sBatchId}\r\n`,                                                                                                                                                                                                                                 
          `Content-Type: multipart/mixed;boundary=${sChangesetId}\r\n\r\n`,                                                                                                                                                                                    
        ];                                                                                                                                                                                                                                                     
        const sBody = oParameters ? JSON.stringify(oParameters) : "{}";                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        aUrls.forEach((sUrl, index) => {                                                                                                                                                                                                                       
          // Extract just the entity and action part                                                                                                                                                                                                           
          const aParts = sUrl.split("/");                                                                                                                                                                                                                      
          const sEntityPart = aParts[aParts.length - 2]; // Travel('1')                                                                                                                                                                                        
          const sActionPart = aParts[aParts.length - 1]; // action name                                                                                                                                                                                        
          const sRelativeUrl = `${sEntityPart}/${sActionPart}`;                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
          aPayloadParts.push(`--${sChangesetId}\r\n`);                                                                                                                                                                                                         
          aPayloadParts.push("Content-Type:application/http\r\n");                                                                                                                                                                                             
          aPayloadParts.push("Content-Transfer-Encoding:binary\r\n");                                                                                                                                                                                          
          aPayloadParts.push(`Content-ID:${index}.0\r\n\r\n`);                                                                                                                                                                                                 
          aPayloadParts.push(`POST ${sRelativeUrl} HTTP/1.1\r\n`);                                                                                                                                                                                             
          aPayloadParts.push(                                                                                                                                                                                                                                  
            "Accept:application/json;odata.metadata=minimal;IEEE754Compatible=true\r\n"                                                                                                                                                                        
          );                                                                                                                                                                                                                                                   
          aPayloadParts.push("Accept-Language:en\r\n");                                                                                                                                                                                                        
          aPayloadParts.push(`X-CSRF-Token:${sCsrfToken}\r\n`);                                                                                                                                                                                                
          aPayloadParts.push("Prefer:handling=strict\r\n");                                                                                                                                                                                                    
          aPayloadParts.push(                                                                                                                                                                                                                                  
            "Content-Type:application/json;charset=UTF-8;IEEE754Compatible=true\r\n\r\n"                                                                                                                                                                       
          );                                                                                                                                                                                                                                                   
          aPayloadParts.push(`${sBody}\r\n`);                                                                                                                                                                                                                  
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        aPayloadParts.push(`--${sChangesetId}--\r\n`);                                                                                                                                                                                                         
        aPayloadParts.push(`--${sBatchId}--\r\n`);                                                                                                                                                                                                             
        const payload = aPayloadParts.join("");                                                                                                                                                                                                                
        return { payload: payload, batchId: sBatchId, csrfToken: sCsrfToken };                                                                                                                                                                                 
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Parses a raw multipart/mixed batch response string into an array of results.                                                                                                                                                                          
       * @private                                                                                                                                                                                                                                              
       * @param {string} sResponseText - The raw text of the batch response.                                                                                                                                                                                   
       * @returns {object[]} An array of result objects, similar to Promise.allSettled.                                                                                                                                                                        
       */                                                                                                                                                                                                                                                      
      _parseBatchResponse: function (sResponseText) {                                                                                                                                                                                                          
        if (!sResponseText) {                                                                                                                                                                                                                                  
          return [];                                                                                                                                                                                                                                           
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        const aResults = [];                                                                                                                                                                                                                                   
        // Find the boundary from the first line of the response                                                                                                                                                                                               
        const sBoundaryMatch = sResponseText.match(/boundary=(.+)/);                                                                                                                                                                                           
        if (!sBoundaryMatch) {                                                                                                                                                                                                                                 
          console.error("Could not find boundary in batch response.");                                                                                                                                                                                         
          return [                                                                                                                                                                                                                                             
            { status: "rejected", reason: "Invalid batch response format." },                                                                                                                                                                                  
          ];                                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
        const sBoundary = `--${sBoundaryMatch[1].trim()}`;                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Split the response into parts using the boundary                                                                                                                                                                                                    
        const aParts = sResponseText                                                                                                                                                                                                                           
          .split(sBoundary)                                                                                                                                                                                                                                    
          .filter((part) => part.trim() !== "" && part.trim() !== "--");                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
        aParts.forEach((sPart) => {                                                                                                                                                                                                                            
          // We only care about the parts that contain an HTTP response                                                                                                                                                                                        
          if (sPart.includes("Content-Type: application/http")) {                                                                                                                                                                                              
            this._processResponsePart(sPart, aResults);                                                                                                                                                                                                        
          }                                                                                                                                                                                                                                                    
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        return aResults;                                                                                                                                                                                                                                       
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Processes a single part of a multipart batch response.                                                                                                                                                                                                
       * @private                                                                                                                                                                                                                                              
       * @param {string} sResponsePart - The text of a single response part.                                                                                                                                                                                   
       * @param {object[]} aResults - The array to push the parsed result into.                                                                                                                                                                                
       */                                                                                                                                                                                                                                                      
      _processResponsePart: function (sResponsePart, aResults) {                                                                                                                                                                                               
        const isSuccess = sResponsePart.includes("HTTP/1.1 2"); // Check for 2xx status codes                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        if (isSuccess) {                                                                                                                                                                                                                                       
          try {                                                                                                                                                                                                                                                
            // Find the start and end of the JSON body                                                                                                                                                                                                         
            const jsonStart = sResponsePart.indexOf("{");                                                                                                                                                                                                      
            const jsonEnd = sResponsePart.lastIndexOf("}") + 1;                                                                                                                                                                                                
            if (jsonStart !== -1 && jsonEnd > jsonStart) {                                                                                                                                                                                                     
              const sJson = sResponsePart.substring(jsonStart, jsonEnd);                                                                                                                                                                                       
              aResults.push({ status: "fulfilled", value: JSON.parse(sJson) });                                                                                                                                                                                
            } else {                                                                                                                                                                                                                                           
              // Handle 204 No Content success case                                                                                                                                                                                                            
              aResults.push({ status: "fulfilled", value: null });                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
          } catch (e) {                                                                                                                                                                                                                                        
            aResults.push({                                                                                                                                                                                                                                    
              status: "rejected",                                                                                                                                                                                                                              
              reason: `Failed to parse JSON response: ${e.message}`,                                                                                                                                                                                           
            });                                                                                                                                                                                                                                                
          }                                                                                                                                                                                                                                                    
        } else {                                                                                                                                                                                                                                               
          // Try to extract an error message from the body for better debugging                                                                                                                                                                                
          const sErrorMatch = sResponsePart.match(/"message"\s*:\s*"([^"]+)"/);                                                                                                                                                                                
          const sReason = sErrorMatch                                                                                                                                                                                                                          
            ? sErrorMatch[1]                                                                                                                                                                                                                                   
            : "Request failed with a non-2xx status code.";                                                                                                                                                                                                    
          aResults.push({ status: "rejected", reason: sReason });                                                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Fetches a CSRF token from the service, using a cache to avoid redundant requests.                                                                                                                                                                     
       * @private                                                                                                                                                                                                                                              
       * @param {string} sServiceUrl - The root URL of the OData service.                                                                                                                                                                                      
       * @returns {Promise<string>} A promise that resolves with the CSRF token.                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      _fetchCsrfTokenCached: async function (sServiceUrl) {                                                                                                                                                                                                    
        const sCacheKey = sServiceUrl;                                                                                                                                                                                                                         
        const oCachedToken = oTokenCache.get(sCacheKey);                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
        if (                                                                                                                                                                                                                                                   
          oCachedToken &&                                                                                                                                                                                                                                      
          Date.now() - oCachedToken.timestamp < TOKEN_CACHE_TTL                                                                                                                                                                                                
        ) {                                                                                                                                                                                                                                                    
          return oCachedToken.token;                                                                                                                                                                                                                           
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        const sToken = await this._fetchCsrfToken(sServiceUrl);                                                                                                                                                                                                
        oTokenCache.set(sCacheKey, {                                                                                                                                                                                                                           
          token: sToken,                                                                                                                                                                                                                                       
          timestamp: Date.now(),                                                                                                                                                                                                                               
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        return sToken;                                                                                                                                                                                                                                         
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Fetches a CSRF token using the native fetch API.                                                                                                                                                                                                      
       * @private                                                                                                                                                                                                                                              
       * @param {string} sServiceUrl - The root URL of the OData service.                                                                                                                                                                                      
       * @returns {Promise<string>} A promise that resolves with the CSRF token.                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      _fetchCsrfToken: async function (sServiceUrl) {                                                                                                                                                                                                          
        const oResponse = await fetch(sServiceUrl, {                                                                                                                                                                                                           
          method: "HEAD",                                                                                                                                                                                                                                      
          headers: { "X-CSRF-Token": "Fetch" },                                                                                                                                                                                                                
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        if (!oResponse.ok) {                                                                                                                                                                                                                                   
          throw new Error(                                                                                                                                                                                                                                     
            `Failed to fetch CSRF token. Status: ${oResponse.status}`                                                                                                                                                                                          
          );                                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return oResponse.headers.get("x-csrf-token");                                                                                                                                                                                                          
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Executes the batch request using the native fetch API.                                                                                                                                                                                                
       * @private                                                                                                                                                                                                                                              
       * @param {string} sServiceUrl - The root URL of the OData service.                                                                                                                                                                                      
       * @param {object} oBatchData - The object containing the payload, batch ID, and token.                                                                                                                                                                  
       * @returns {Promise<string>} A promise that resolves with the raw response text.                                                                                                                                                                        
       */                                                                                                                                                                                                                                                      
      _executeBatchRequest: async function (sServiceUrl, oBatchData) {                                                                                                                                                                                         
        const oResponse = await fetch(`${sServiceUrl}$batch`, {                                                                                                                                                                                                
          method: "POST",                                                                                                                                                                                                                                      
          headers: {                                                                                                                                                                                                                                           
            "X-CSRF-Token": oBatchData.csrfToken || "",                                                                                                                                                                                                        
            "Content-Type": `multipart/mixed; boundary=${oBatchData.batchId}`,                                                                                                                                                                                 
            Accept: "multipart/mixed",                                                                                                                                                                                                                         
          },                                                                                                                                                                                                                                                   
          body: oBatchData.payload,                                                                                                                                                                                                                            
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        if (!oResponse.ok) {                                                                                                                                                                                                                                   
          const sErrorText = await oResponse.text();                                                                                                                                                                                                           
          console.error("Batch Request Failed:", {                                                                                                                                                                                                             
            status: oResponse.status,                                                                                                                                                                                                                          
            statusText: oResponse.statusText,                                                                                                                                                                                                                  
            responseText: sErrorText,                                                                                                                                                                                                                          
          });                                                                                                                                                                                                                                                  
          throw new Error(                                                                                                                                                                                                                                     
            `Batch request failed with status ${oResponse.status}.`                                                                                                                                                                                            
          );                                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return oResponse.text();                                                                                                                                                                                                                               
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Executes a single static (unbound) action request using the native fetch API.                                                                                                                                                                         
       * @private                                                                                                                                                                                                                                              
       * @param {string} sServiceUrl - The root URL of the OData service.                                                                                                                                                                                      
       * @param {string} sActionPath - The path to the OData action.                                                                                                                                                                                           
       * @param {object} oParameters - The parameters for the action.                                                                                                                                                                                          
       * @param {string} sCsrfToken - The CSRF token.                                                                                                                                                                                                          
       * @returns {Promise<object>} A promise that resolves with the JSON response object.                                                                                                                                                                     
       */                                                                                                                                                                                                                                                      
      _executeStaticActionRequest: async function (                                                                                                                                                                                                            
        sServiceUrl,                                                                                                                                                                                                                                           
        sActionPath,                                                                                                                                                                                                                                           
        oParameters,                                                                                                                                                                                                                                           
        sCsrfToken                                                                                                                                                                                                                                             
      ) {                                                                                                                                                                                                                                                      
        const sActionUrl = `${sServiceUrl.slice(0, -1)}${sActionPath}`; // Ensure no double slashes                                                                                                                                                            
        const sBody = oParameters ? JSON.stringify(oParameters) : "{}";                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        const oResponse = await fetch(sActionUrl, {                                                                                                                                                                                                            
          method: "POST",                                                                                                                                                                                                                                      
          headers: {                                                                                                                                                                                                                                           
            "X-CSRF-Token": sCsrfToken,                                                                                                                                                                                                                        
            "Content-Type":                                                                                                                                                                                                                                    
              "application/json;charset=UTF-8;IEEE754Compatible=true",                                                                                                                                                                                         
          },                                                                                                                                                                                                                                                   
          body: sBody,                                                                                                                                                                                                                                         
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        if (!oResponse.ok) {                                                                                                                                                                                                                                   
          const sErrorText = await oResponse.text();                                                                                                                                                                                                           
          console.error("Static Action Request Failed:", {                                                                                                                                                                                                     
            status: oResponse.status,                                                                                                                                                                                                                          
            statusText: oResponse.statusText,                                                                                                                                                                                                                  
            responseText: sErrorText,                                                                                                                                                                                                                          
          });                                                                                                                                                                                                                                                  
          throw new Error(                                                                                                                                                                                                                                     
            `Static action request failed with status ${oResponse.status}.`                                                                                                                                                                                    
          );                                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        return oResponse.status === 204 ? null : oResponse.json(); // Handle 204 No Content                                                                                                                                                                    
      },                                                                                                                                                                                                                                                       
    };                                                                                                                                                                                                                                                         
  }                                                                                                                                                                                                                                                            
);                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               