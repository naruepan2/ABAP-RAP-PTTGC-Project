      /**                                                                                                                                                                                                                                                      
       * Decodes Base64 to binary                                                                                                                                                                                                                              
       * @private                                                                                                                                                                                                                                              
       */                                                                                                                                                                                                                                                      
      _base64ToBinary: function (sBase64) {                                                                                                                                                                                                                    
        try {                                                                                                                                                                                                                                                  
