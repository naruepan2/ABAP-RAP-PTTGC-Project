      /**                                                                                                                                                                                                                                                      
       * Converts hex to Base64                                                                                                                                                                                                                                
       * @private                                                                                                                                                                                                                                              
       */                                                                                                                                                                                                                                                      
      _hexToBase64: function (sHexString) {                                                                                                                                                                                                                    
        try {                                                                                                                                                                                                                                                  
          const aChars = [];                                                                                                                                                                                                                                   
          for (let i = 0; i < sHexString.length; i += 2) {                                                                                                                                                                                                     
            aChars.push(                                                                                                                                                                                                                                       
              String.fromCharCode(parseInt(sHexString.substring(i, i + 2), 16))                                                                                                                                                                                
            );                                                                                                                                                                                                                                                 
          }                                                                                                                                                                                                                                                    
          return btoa(aChars.join(""));                                                                                                                                                                                                                        
        } catch (e) {                                                                                                                                                                                                                                          
          console.error("Failed to encode hex-to-binary string to Base64.", e);                                                                                                                                                                                
          return "";                                                                                                                                                                                                                                           
        }                                                                                                                                                                                                                                                      
