  ],                                                                                                                                                                                                                                                           
  function (                                                                                                                                                                                                                                                   
    Library,                                                                                                                                                                                                                                                   
    Spreadsheet,                                                                                                                                                                                                                                               
    Fragment,                                                                                                                                                                                                                                                  
    MessageBox,                                                                                                                                                                                                                                                
    MessageToast,                                                                                                                                                                                                                                              
    FileUploader,                                                                                                                                                                                                                                              
    FileUploaderParameter,                                                                                                                                                                                                                                     
    ODataV4Library,                                                                                                                                                                                                                                            
    IconPool,                                                                                                                                                                                                                                                  
    coreLibrary,                                                                                                                                                                                                                                               
    JSONModel,                                                                                                                                                                                                                                                 
    Link,                                                                                                                                                                                                                                                      
    MessageItem,                                                                                                                                                                                                                                               
    MessageView,                                                                                                                                                                                                                                               
    MessagePopover,                                                                                                                                                                                                                                            
    Button,                                                                                                                                                                                                                                                    
    Dialog,                                                                                                                                                                                                                                                    
    Bar,                                                                                                                                                                                                                                                       
    Title,                                                                                                                                                                                                                                                     
    ScrollContainer,                                                                                                                                                                                                                                           
    VBox,                                                                                                                                                                                                                                                      
    Label,                                                                                                                                                                                                                                                     
    Text                                                                                                                                                                                                                                                       
  ) {                                                                                                                                                                                                                                                          
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * ========================================================================                                                                                                                                                                                
     * Internal Controller - Manages upload dialog and fragment lifecycle                                                                                                                                                                                      
     * (Defined first but used by Public API methods below)                                                                                                                                                                                                    
