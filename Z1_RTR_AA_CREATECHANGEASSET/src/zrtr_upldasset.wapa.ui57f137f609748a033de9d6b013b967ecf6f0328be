              });                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
              const iRowCount = oFileData.rowCount;                                                                                                                                                                                                            
              const base64Data = oFileData.base64;                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
              if (iRowCount > MAX_ROWS) {                                                                                                                                                                                                                      
                MessageBox.error(                                                                                                                                                                                                                              
                  `File contains ${iRowCount} rows. Maximum allowed is ${MAX_ROWS} rows. Please split your file into smaller chunks.`                                                                                                                          
                );                                                                                                                                                                                                                                             
                return;                                                                                                                                                                                                                                        
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              const oParameters = {                                                                                                                                                                                                                            
                ...oConfig.odataParameters,                                                                                                                                                                                                                    
                [oConfig.fileContentParameterName]: base64Data,                                                                                                                                                                                                
              };                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
              oSpreadSheetController.oDialog.close();                                                                                                                                                                                                          
              oSpreadSheetController.oDialog.setBusy(false);                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
              await ODataV4Library.executeActionForContexts(                                                                                                                                                                                                   
                null,                                                                                                                                                                                                                                          
                oConfig.actionName,                                                                                                                                                                                                                            
                oConfig.model,                                                                                                                                                                                                                                 
                oParameters,                                                                                                                                                                                                                                   
                "true"                                                                                                                                                                                                                                         
              );                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
              oFileData.base64 = null;                                                                                                                                                                                                                         
              oFileData.rowCount = null;                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
              if (oConfig.model && oConfig.model.refresh) {                                                                                                                                                                                                    
                oConfig.model.refresh();                                                                                                                                                                                                                       
              }                                                                                                                                                                                                                                                
              if (oConfig.controller && oConfig.controller.refresh) {                                                                                                                                                                                          
                oConfig.controller.refresh();                                                                                                                                                                                                                  
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              MessageToast.show("Upload Successful");                                                                                                                                                                                                          
            } catch (oError) {                                                                                                                                                                                                                                 
              const oErrorPayload = oError?.error;                                                                                                                                                                                                             
              let aAllErrors = [];                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
              if (oErrorPayload?.message) {                                                                                                                                                                                                                    
                aAllErrors.push({                                                                                                                                                                                                                              
                  code: oErrorPayload.code,                                                                                                                                                                                                                    
                  message: oErrorPayload.message,                                                                                                                                                                                                              
                  target: oErrorPayload.target,                                                                                                                                                                                                                
                });                                                                                                                                                                                                                                            
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              if (Array.isArray(oErrorPayload?.details)) {                                                                                                                                                                                                     
                aAllErrors = aAllErrors.concat(oErrorPayload.details);                                                                                                                                                                                         
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              if (aAllErrors.length > 1) {                                                                                                                                                                                                                     
                aAllErrors.reverse();                                                                                                                                                                                                                          
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              if (aAllErrors.length > 0) {                                                                                                                                                                                                                     
                const aMessages = aAllErrors.map((oDetail) => ({                                                                                                                                                                                               
                  type: coreLibrary.MessageType.Error,                                                                                                                                                                                                         
                  title: oDetail.message,                                                                                                                                                                                                                      
                  description: oDetail.target ? `Target: ${oDetail.target}` : "",                                                                                                                                                                              
                  subtitle: oDetail.code ? `Code: ${oDetail.code}` : "",                                                                                                                                                                                       
                }));                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                const oMessageView = new MessageView({                                                                                                                                                                                                         
                  showDetailsPageHeader: false,                                                                                                                                                                                                                
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                const oMessageModel = new JSONModel();                                                                                                                                                                                                         
                oMessageModel.setData(aMessages);                                                                                                                                                                                                              
                oMessageView.setModel(oMessageModel);                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                oMessageView.bindAggregation("items", {                                                                                                                                                                                                        
                  path: "/",                                                                                                                                                                                                                                   
                  template: new MessageItem({                                                                                                                                                                                                                  
                    type: "{type}",                                                                                                                                                                                                                            
                    title: "{title}",                                                                                                                                                                                                                          
                    description: "{description}",                                                                                                                                                                                                              
                    subtitle: "{subtitle}",                                                                                                                                                                                                                    
                  }),                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                const oErrorDialog = new Dialog({                                                                                                                                                                                                              
                  resizable: true,                                                                                                                                                                                                                             
                  title: "Upload Errors",                                                                                                                                                                                                                      
                  content: oMessageView,                                                                                                                                                                                                                       
                  state: "Error",                                                                                                                                                                                                                              
                  contentHeight: "50%",                                                                                                                                                                                                                        
                  contentWidth: "50%",                                                                                                                                                                                                                         
                  verticalScrolling: false,                                                                                                                                                                                                                    
                  beginButton: new Button({                                                                                                                                                                                                                    
                    text: "Close",                                                                                                                                                                                                                             
                    press: function () {                                                                                                                                                                                                                       
                      oErrorDialog.close();                                                                                                                                                                                                                    
                    },                                                                                                                                                                                                                                         
                  }),                                                                                                                                                                                                                                          
                  afterClose: function () {                                                                                                                                                                                                                    
                    oErrorDialog.destroy();                                                                                                                                                                                                                    
                  },                                                                                                                                                                                                                                           
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                oErrorDialog.open();                                                                                                                                                                                                                           
              } else {                                                                                                                                                                                                                                         
                const sMessage = oError.message || "An unknown error occurred during upload.";                                                                                                                                                                 
                MessageBox.error(sMessage);                                                                                                                                                                                                                    
              }                                                                                                                                                                                                                                                
            } finally {                                                                                                                                                                                                                                        
              oSpreadSheetController.oDialog.setBusy(false);                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
          },                                                                                                                                                                                                                                                   
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        // Create Dialog                                                                                                                                                                                                                                       
        const oDialog = new Dialog({                                                                                                                                                                                                                           
          title: "Upload Excel File",                                                                                                                                                                                                                          
          resizable: true,                                                                                                                                                                                                                                     
          draggable: true,                                                                                                                                                                                                                                     
          horizontalScrolling: false,                                                                                                                                                                                                                          
          verticalScrolling: false,                                                                                                                                                                                                                            
          content: [                                                                                                                                                                                                                                           
            new VBox({                                                                                                                                                                                                                                         
              height: "100%",                                                                                                                                                                                                                                  
              fitContainer: true,                                                                                                                                                                                                                              
              items: [                                                                                                                                                                                                                                         
                new Label({                                                                                                                                                                                                                                    
                  text: "Select Excel File",                                                                                                                                                                                                                   
                  labelFor: oFileUploader,                                                                                                                                                                                                                     
                  width: "24rem",                                                                                                                                                                                                                              
                  required: true,                                                                                                                                                                                                                              
                  wrapping: true,                                                                                                                                                                                                                              
                }),                                                                                                                                                                                                                                            
                oFileUploader,                                                                                                                                                                                                                                 
                oFileInfoText,                                                                                                                                                                                                                                 
              ],                                                                                                                                                                                                                                               
            }),                                                                                                                                                                                                                                                
          ],                                                                                                                                                                                                                                                   
          beginButton: oUploadButton,                                                                                                                                                                                                                          
          endButton: new Button({                                                                                                                                                                                                                              
            text: "Cancel",                                                                                                                                                                                                                                    
            press: function () {                                                                                                                                                                                                                               
              oDialog.close();                                                                                                                                                                                                                                 
            },                                                                                                                                                                                                                                                 
          }),                                                                                                                                                                                                                                                  
          afterClose: function () {                                                                                                                                                                                                                            
            oFileUploader.destroy();                                                                                                                                                                                                                           
            oFileInfoText.destroy();                                                                                                                                                                                                                           
            oDialog.destroy();                                                                                                                                                                                                                                 
            oSpreadSheetController.oDialog = null;                                                                                                                                                                                                             
          },                                                                                                                                                                                                                                                   
        });                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
        // Add to view if controller provided                                                                                                                                                                                                                  
        if (oConfig.controller && oConfig.controller._view) {                                                                                                                                                                                                  
          oConfig.controller._view.addDependent(oDialog);                                                                                                                                                                                                      
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        oDialog.addStyleClass("sapUiPopupWithPadding");                                                                                                                                                                                                        
        oSpreadSheetController.oDialog = oDialog;                                                                                                                                                                                                              
        oDialog.open();                                                                                                                                                                                                                                        
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Dynamically imports SheetJS library from CDN                                                                                                                                                                                                          
       * @private                                                                                                                                                                                                                                              
       */                                                                                                                                                                                                                                                      
      _importXLSXLibrary: async function () {                                                                                                                                                                                                                  
        return import("https://cdn.sheetjs.com/xlsx-0.20.3/package/xlsx.mjs");                                                                                                                                                                                 
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
