          const sBinaryString = atob(paddedBase64);                                                                                                                                                                                                            
          const aBytes = new Uint8Array(sBinaryString.length);                                                                                                                                                                                                 
          for (let i = 0; i < sBinaryString.length; i++) {                                                                                                                                                                                                     
            aBytes[i] = sBinaryString.charCodeAt(i);                                                                                                                                                                                                           
          }                                                                                                                                                                                                                                                    
          return aBytes;                                                                                                                                                                                                                                       
        } catch (e) {                                                                                                                                                                                                                                          
          console.error("Failed to decode Base64 string:", e);                                                                                                                                                                                                 
          return null;                                                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
