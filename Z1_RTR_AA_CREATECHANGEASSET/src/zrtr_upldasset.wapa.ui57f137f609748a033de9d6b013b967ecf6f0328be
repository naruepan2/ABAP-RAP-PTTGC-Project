      /**                                                                                                                                                                                                                                                      
       * Checks if string is Base64                                                                                                                                                                                                                            
       * @private                                                                                                                                                                                                                                              
       */                                                                                                                                                                                                                                                      
      _isBase64: function (sString) {                                                                                                                                                                                                                          
        if (typeof sString !== "string" || sString === null || sString === "") {                                                                                                                                                                               
          return false;                                                                                                                                                                                                                                        
        }                                                                                                                                                                                                                                                      
        return /^[A-Za-z0-9+/]+={0,2}$/.test(sString.trim());                                                                                                                                                                                                  
