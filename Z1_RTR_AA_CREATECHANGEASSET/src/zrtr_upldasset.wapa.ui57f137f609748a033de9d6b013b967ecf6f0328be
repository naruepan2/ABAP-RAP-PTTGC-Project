        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (typeof Blob !== "undefined" && data instanceof Blob) {                                                                                                                                                                                             
          return true;                                                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (typeof Buffer !== "undefined" && Buffer.isBuffer(data)) {                                                                                                                                                                                          
