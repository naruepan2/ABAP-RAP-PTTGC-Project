     */                                                                                                                                                                                                                                                        
    const oSpreadSheetController = {                                                                                                                                                                                                                           
      oDialog: null,                                                                                                                                                                                                                                           
      oXLSX: null, // Cache for SheetJS library                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
      createFragmentController: function (oContext) {                                                                                                                                                                                                          
        const {                                                                                                                                                                                                                                                
          oController,                                                                                                                                                                                                                                         
          oModel,                                                                                                                                                                                                                                              
          sActionName,                                                                                                                                                                                                                                         
          oODataParameters,                                                                                                                                                                                                                                    
          sFileContentParameterName,                                                                                                                                                                                                                           
          sFragmentId,                                                                                                                                                                                                                                         
          sFileUploaderId,                                                                                                                                                                                                                                     
          sheetName,                                                                                                                                                                                                                                           
          sheetIndex,                                                                                                                                                                                                                                          
          uploadAllSheets,                                                                                                                                                                                                                                     
          fnOnSuccess,                                                                                                                                                                                                                                         
          fnOnError                                                                                                                                                                                                                                            
        } = oContext;                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
        const MAX_ROWS = 500000; // Configurable row limit                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        return {                                                                                                                                                                                                                                               
          /**                                                                                                                                                                                                                                                  
           * Handles Excel file upload with validation and error handling                                                                                                                                                                                      
           */                                                                                                                                                                                                                                                  
          handleUploadPress: async function (oEvent) {                                                                                                                                                                                                         
            const oView = oController._view;                                                                                                                                                                                                                   
            const oFileUploader = Fragment.byId(sFragmentId, sFileUploaderId);                                                                                                                                                                                 
            const oFile = oFileUploader.oFileUpload.files[0];                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (!oFile) {                                                                                                                                                                                                                                      
              MessageToast.show("Please select a file to upload.");                                                                                                                                                                                            
              return;                                                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (!oSpreadSheetController.oXLSX) {                                                                                                                                                                                                               
              MessageToast.show("Spreadsheet library not loaded. Please try again.");                                                                                                                                                                          
              return;                                                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oView.setBusy(true);                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
              await oFileUploader.checkFileReadable();                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
              const oFileData = await this._readFileAsBase64(oFile, sheetName, sheetIndex, uploadAllSheets);                                                                                                                                                   
              const iRowCount = oFileData.rowCount;                                                                                                                                                                                                            
              const base64Data = oFileData.base64;                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
              if (iRowCount > MAX_ROWS) {                                                                                                                                                                                                                      
                MessageBox.error(                                                                                                                                                                                                                              
                  `File contains ${iRowCount} rows. Maximum allowed is ${MAX_ROWS} rows. Please split your file into smaller chunks.`                                                                                                                          
                );                                                                                                                                                                                                                                             
                return;                                                                                                                                                                                                                                        
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              const oParameters = {                                                                                                                                                                                                                            
                ...oODataParameters,                                                                                                                                                                                                                           
                [sFileContentParameterName]: base64Data,                                                                                                                                                                                                       
              };                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
              this._closeDialog();                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
              const aResults = await ODataV4Library.executeActionForContexts(                                                                                                                                                                                  
                null,                                                                                                                                                                                                                                          
                sActionName,                                                                                                                                                                                                                                   
                oModel,                                                                                                                                                                                                                                        
                oParameters,                                                                                                                                                                                                                                   
                "true"                                                                                                                                                                                                                                         
              );                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
              // Memory cleanup                                                                                                                                                                                                                                
              oFileData.base64 = null;                                                                                                                                                                                                                         
              oFileData.rowCount = null;                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
              oModel.refresh();                                                                                                                                                                                                                                
              oController.refresh();                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
              // Call success callback if provided                                                                                                                                                                                                             
              // Passes backend response (aResults) to your callback function                                                                                                                                                                                  
              // This allows you to access upload results in your controller                                                                                                                                                                                   
              if (typeof fnOnSuccess === "function") {                                                                                                                                                                                                         
                fnOnSuccess(aResults);                                                                                                                                                                                                                         
              }                                                                                                                                                                                                                                                
            } catch (oError) {                                                                                                                                                                                                                                 
              // Check if it's an empty file error                                                                                                                                                                                                             
              if (oError.message && oError.message.includes("Excel file is empty")) {                                                                                                                                                                          
                MessageToast.show(oError.message, {                                                                                                                                                                                                            
                  duration: 3000,                                                                                                                                                                                                                              
                  width: "20em"                                                                                                                                                                                                                                
                });                                                                                                                                                                                                                                            
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                               
                // Call error callback if provided                                                                                                                                                                                                             
                if (typeof fnOnError === "function") {                                                                                                                                                                                                         
                  fnOnError(oError);                                                                                                                                                                                                                           
                }                                                                                                                                                                                                                                              
                return;                                                                                                                                                                                                                                        
              }                                                                                                                                                                                                                                                
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                           
              const oErrorPayload = oError?.error;                                                                                                                                                                                                             
              let aAllErrors = [];                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
              if (oErrorPayload?.message) {                                                                                                                                                                                                                    
                aAllErrors.push({                                                                                                                                                                                                                              
                  code: oErrorPayload.code,                                                                                                                                                                                                                    
                  message: oErrorPayload.message,                                                                                                                                                                                                              
                  target: oErrorPayload.target,                                                                                                                                                                                                                
                });                                                                                                                                                                                                                                            
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              if (Array.isArray(oErrorPayload?.details)) {                                                                                                                                                                                                     
                aAllErrors = aAllErrors.concat(oErrorPayload.details);                                                                                                                                                                                         
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              if (aAllErrors.length > 1) {                                                                                                                                                                                                                     
                aAllErrors.reverse();                                                                                                                                                                                                                          
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              if (aAllErrors.length > 0) {                                                                                                                                                                                                                     
                this._showErrorPopover.bind(this)(aAllErrors, oEvent.getSource());                                                                                                                                                                             
              } else {                                                                                                                                                                                                                                         
                const sMessage = oError.message || "An unknown error occurred during upload.";                                                                                                                                                                 
                MessageBox.error(sMessage);                                                                                                                                                                                                                    
              }                                                                                                                                                                                                                                                
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                           
              // Call error callback if provided                                                                                                                                                                                                               
              // Passes error object to your callback function                                                                                                                                                                                                 
              // This allows you to handle errors in your controller                                                                                                                                                                                           
              if (typeof fnOnError === "function") {                                                                                                                                                                                                           
                fnOnError(oError);                                                                                                                                                                                                                             
              }                                                                                                                                                                                                                                                
            } finally {                                                                                                                                                                                                                                        
              oView.setBusy(false);                                                                                                                                                                                                                            
              this._closeDialog();                                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
          },                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          /**                                                                                                                                                                                                                                                  
           * Displays detailed error messages in a dialog with MessageView                                                                                                                                                                                     
           */                                                                                                                                                                                                                                                  
          _showErrorPopover: function (aErrorDetails, oSource) {                                                                                                                                                                                               
            const aMessages = aErrorDetails.map((oDetail) => ({                                                                                                                                                                                                
              type: coreLibrary.MessageType.Error,                                                                                                                                                                                                             
              title: oDetail.message,                                                                                                                                                                                                                          
              description: oDetail.target ? `Target: ${oDetail.target}` : "",                                                                                                                                                                                  
              subtitle: oDetail.code ? `Code: ${oDetail.code}` : "",                                                                                                                                                                                           
            }));                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            const oMessageView = new MessageView({                                                                                                                                                                                                             
              showDetailsPageHeader: false,                                                                                                                                                                                                                    
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const oMessageModel = new JSONModel();                                                                                                                                                                                                             
            oMessageModel.setData(aMessages);                                                                                                                                                                                                                  
            oMessageView.setModel(oMessageModel);                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            oMessageView.bindAggregation("items", {                                                                                                                                                                                                            
              path: "/",                                                                                                                                                                                                                                       
              template: new MessageItem({                                                                                                                                                                                                                      
                type: "{type}",                                                                                                                                                                                                                                
                title: "{title}",                                                                                                                                                                                                                              
                description: "{description}",                                                                                                                                                                                                                  
                subtitle: "{subtitle}",                                                                                                                                                                                                                        
              }),                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            const oDialog = new Dialog({                                                                                                                                                                                                                       
              resizable: true,                                                                                                                                                                                                                                 
              title: "Upload Errors",                                                                                                                                                                                                                          
              content: oMessageView,                                                                                                                                                                                                                           
              state: "Error",                                                                                                                                                                                                                                  
              contentHeight: "50%",                                                                                                                                                                                                                            
              contentWidth: "50%",                                                                                                                                                                                                                             
              verticalScrolling: false,                                                                                                                                                                                                                        
              beginButton: new Button({                                                                                                                                                                                                                        
                text: "Close",                                                                                                                                                                                                                                 
                press: function () {                                                                                                                                                                                                                           
                  oDialog.close();                                                                                                                                                                                                                             
                },                                                                                                                                                                                                                                             
              }),                                                                                                                                                                                                                                              
              afterClose: function () {                                                                                                                                                                                                                        
                oDialog.destroy();                                                                                                                                                                                                                             
              },                                                                                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            oController._view.addDependent(oDialog);                                                                                                                                                                                                           
            oDialog.open();                                                                                                                                                                                                                                    
          },                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          /**                                                                                                                                                                                                                                                  
           * Reads Excel file and converts to Base64 with row count                                                                                                                                                                                            
           * @param {File} oFile - File object                                                                                                                                                                                                                 
           * @param {string} [sSheetName] - Specific sheet name to read                                                                                                                                                                                        
           * @param {number} [iSheetIndex] - Specific sheet index to read (0-based)                                                                                                                                                                            
           * @param {boolean} [bUploadAllSheets] - Upload entire workbook (all sheets)                                                                                                                                                                         
           */                                                                                                                                                                                                                                                  
          _readFileAsBase64: function (oFile, sSheetName, iSheetIndex, bUploadAllSheets) {                                                                                                                                                                     
            return new Promise((resolve, reject) => {                                                                                                                                                                                                          
              const reader = new FileReader();                                                                                                                                                                                                                 
              reader.onload = (e) => {                                                                                                                                                                                                                         
                try {                                                                                                                                                                                                                                          
                  const data = e.target.result;                                                                                                                                                                                                                
                  const workbook = oSpreadSheetController.oXLSX.read(data, {                                                                                                                                                                                   
                    type: "binary",                                                                                                                                                                                                                            
                  });                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                  // Check if workbook has sheets                                                                                                                                                                                                              
                  if (!workbook.SheetNames || workbook.SheetNames.length === 0) {                                                                                                                                                                              
                    reject(new Error("Excel file is empty. Please upload a file with data."));                                                                                                                                                                 
                    return;                                                                                                                                                                                                                                    
                  }                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                  // If uploadAllSheets is true, upload entire workbook                                                                                                                                                                                        
                  if (bUploadAllSheets === true) {                                                                                                                                                                                                             
                    const base64 = oSpreadSheetController.oXLSX.write(workbook, {                                                                                                                                                                              
                      bookType: "xlsx",                                                                                                                                                                                                                        
                      type: "base64",                                                                                                                                                                                                                          
                    });                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    // Calculate total row count across all sheets                                                                                                                                                                                             
                    let iTotalRows = 0;                                                                                                                                                                                                                        
                    workbook.SheetNames.forEach(sheetName => {                                                                                                                                                                                                 
                      const sheet = workbook.Sheets[sheetName];                                                                                                                                                                                                
                      if (sheet && sheet["!ref"]) {                                                                                                                                                                                                            
                        const range = oSpreadSheetController.oXLSX.utils.decode_range(sheet["!ref"]);                                                                                                                                                          
                        iTotalRows += (range.e.r - range.s.r + 1);                                                                                                                                                                                             
                      }                                                                                                                                                                                                                                        
                    });                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    // Memory cleanup                                                                                                                                                                                                                          
                    workbook.Sheets = null;                                                                                                                                                                                                                    
                    workbook.SheetNames = null;                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                    resolve({ base64, rowCount: iTotalRows });                                                                                                                                                                                                 
                    return;                                                                                                                                                                                                                                    
                  }                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                  // Determine which sheet to read                                                                                                                                                                                                             
                  let sTargetSheetName;                                                                                                                                                                                                                        
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                   
                  if (sSheetName && sSheetName.trim() !== "") {                                                                                                                                                                                                
                    // Use specified sheet name (case-insensitive)                                                                                                                                                                                             
                    const sFoundSheet = workbook.SheetNames.find(                                                                                                                                                                                              
                      sheet => sheet.toLowerCase() === sSheetName.toLowerCase()                                                                                                                                                                                
                    );                                                                                                                                                                                                                                         
                    if (!sFoundSheet) {                                                                                                                                                                                                                        
                      reject(new Error(`Sheet "${sSheetName}" not found. Available sheets: ${workbook.SheetNames.join(", ")}`));                                                                                                                               
                      return;                                                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                    sTargetSheetName = sFoundSheet;                                                                                                                                                                                                            
                  } else if (typeof iSheetIndex === "number" && iSheetIndex >= 0) {                                                                                                                                                                            
                    // Use specified sheet index                                                                                                                                                                                                               
                    if (iSheetIndex >= workbook.SheetNames.length) {                                                                                                                                                                                           
                      reject(new Error(`Sheet index ${iSheetIndex} is out of range. File has ${workbook.SheetNames.length} sheet(s).`));                                                                                                                       
                      return;                                                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                    sTargetSheetName = workbook.SheetNames[iSheetIndex];                                                                                                                                                                                       
                  } else {                                                                                                                                                                                                                                     
                    // Default to first sheet                                                                                                                                                                                                                  
                    sTargetSheetName = workbook.SheetNames[0];                                                                                                                                                                                                 
                  }                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                  const firstSheet = workbook.Sheets[sTargetSheetName];                                                                                                                                                                                        
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                   
                  // Check if sheet has reference (data)                                                                                                                                                                                                       
                  if (!firstSheet || !firstSheet["!ref"]) {                                                                                                                                                                                                    
                    // Memory cleanup                                                                                                                                                                                                                          
                    workbook.Sheets = null;                                                                                                                                                                                                                    
                    workbook.SheetNames = null;                                                                                                                                                                                                                
                    reject(new Error("Excel file is empty. Please upload a file with data."));                                                                                                                                                                 
                    return;                                                                                                                                                                                                                                    
                  }                                                                                                                                                                                                                                            
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                   
                  const range = oSpreadSheetController.oXLSX.utils.decode_range(                                                                                                                                                                               
                    firstSheet["!ref"]                                                                                                                                                                                                                         
                  );                                                                                                                                                                                                                                           
                  const iRowCount = range.e.r - range.s.r + 1;                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                  // Check if file has data (more than just header row)                                                                                                                                                                                        
                  if (iRowCount <= 1) {                                                                                                                                                                                                                        
                    // Memory cleanup                                                                                                                                                                                                                          
                    workbook.Sheets = null;                                                                                                                                                                                                                    
                    workbook.SheetNames = null;                                                                                                                                                                                                                
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                       
                    reject(new Error("Excel file is empty. Please upload a file with data."));                                                                                                                                                                 
                    return;                                                                                                                                                                                                                                    
                  }                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                  const base64 = oSpreadSheetController.oXLSX.write(workbook, {                                                                                                                                                                                
                    bookType: "xlsx",                                                                                                                                                                                                                          
                    type: "base64",                                                                                                                                                                                                                            
                  });                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                  // Memory cleanup                                                                                                                                                                                                                            
                  workbook.Sheets = null;                                                                                                                                                                                                                      
                  workbook.SheetNames = null;                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                  resolve({ base64, rowCount: iRowCount });                                                                                                                                                                                                    
                } catch (error) {                                                                                                                                                                                                                              
                  // Convert technical errors to user-friendly messages                                                                                                                                                                                        
                  if (error.message && (error.message.includes("indexOf") || error.message.includes("undefined"))) {                                                                                                                                           
                    reject(new Error("Excel file is empty or invalid. Please upload a valid file with data."));                                                                                                                                                
                  } else {                                                                                                                                                                                                                                     
                    reject(error);                                                                                                                                                                                                                             
                  }                                                                                                                                                                                                                                            
                } finally {                                                                                                                                                                                                                                    
                  reader.onload = null;                                                                                                                                                                                                                        
                  reader.onerror = null;                                                                                                                                                                                                                       
                }                                                                                                                                                                                                                                              
              };                                                                                                                                                                                                                                               
              reader.onerror = (err) => reject(new Error("Failed to read file. Please try again."));                                                                                                                                                           
              reader.readAsBinaryString(oFile);                                                                                                                                                                                                                
            });                                                                                                                                                                                                                                                
          },                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          handleCloseDialog: function (oEvent) {                                                                                                                                                                                                               
            this._closeDialog();                                                                                                                                                                                                                               
          },                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          handleDialogUploadOnChange: function (oEvent) {                                                                                                                                                                                                      
            const oFileUploader = Fragment.byId(sFragmentId, sFileUploaderId);                                                                                                                                                                                 
            const oFile = oFileUploader.oFileUpload.files[0];                                                                                                                                                                                                  
            const oUploadButton = Fragment.byId(sFragmentId, "idUploadFileButton");                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            if (oUploadButton) {                                                                                                                                                                                                                               
              oUploadButton.setEnabled(!!oFile);                                                                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
          },                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
          _closeDialog: function () {                                                                                                                                                                                                                          
            const oFileUploader = Fragment.byId(sFragmentId, sFileUploaderId);                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
