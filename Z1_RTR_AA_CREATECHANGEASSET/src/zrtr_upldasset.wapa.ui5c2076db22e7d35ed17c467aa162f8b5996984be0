sap.ui.define(                                                                                                                                                                                                                                                 
  [                                                                                                                                                                                                                                                            
    "sap/ui/core/Core",                                                                                                                                                                                                                                        
    "sap/base/util/Version",                                                                                                                                                                                                                                   
    "sap/ui/VersionInfo",                                                                                                                                                                                                                                      
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/ui/model/odata/v4/ODataModel",                                                                                                                                                                                                                        
  ],                                                                                                                                                                                                                                                           
  function (Core, VersionUtil, VersionInfo, MessageBox, ODataModelV4) {                                                                                                                                                                                        
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // Performance caching for static action models                                                                                                                                                                                                            
    const oModelCache = new Map();                                                                                                                                                                                                                             
    const oNewDataContextBindingVersion = "1.124.0";                                                                                                                                                                                                           
    const oSetKeepAliveVersion = "1.81.0";                                                                                                                                                                                                                     
    const DEFAULT_TIMEOUT = 1800000; // 30 minutes in milliseconds for debugging                                                                                                                                                                               
    let fnInvokeAction; // Will hold the correct action invocation function based on UI5 version                                                                                                                                                               
    let bSupportsKeepAlive = false; // Will be true if setKeepAlive is supported                                                                                                                                                                               
    let iCustomTimeout = DEFAULT_TIMEOUT; // Configurable timeout                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // Perform version check once at module load time for efficiency                                                                                                                                                                                           
    VersionInfo.load().then(function (oVersionInfo) {                                                                                                                                                                                                          
      const currentVersion = VersionUtil(oVersionInfo.version);                                                                                                                                                                                                
      const targetVersion = VersionUtil(oNewDataContextBindingVersion);                                                                                                                                                                                        
      const keepAliveVersion = VersionUtil(oSetKeepAliveVersion);                                                                                                                                                                                              
      fnInvokeAction = currentVersion >= targetVersion ? "invoke" : "execute";                                                                                                                                                                                 
      bSupportsKeepAlive = currentVersion >= keepAliveVersion;                                                                                                                                                                                                 
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
      /**                                                                                                                                                                                                                                                      
       * Executes an OData V4 action for one or more contexts, or as a static (unbound) action.                                                                                                                                                                
       *&nbsp;                                                                                                                                                                                                                                                 
       * This method handles both:                                                                                                                                                                                                                             
       * 1. Context-bound actions: Actions executed on selected table rows (batch processing)                                                                                                                                                                  
       * 2. Static actions: Unbound actions like file downloads, bulk operations, etc.                                                                                                                                                                         
       *&nbsp;                                                                                                                                                                                                                                                 
       * Features:                                                                                                                                                                                                                                             
       * - Automatic batching for context-bound actions (improves performance)                                                                                                                                                                                 
       * - Direct execution for static actions (avoids batch timeout)                                                                                                                                                                                          
       * - Error handling with user-friendly messages                                                                                                                                                                                                          
       * - Memory management with model caching                                                                                                                                                                                                                
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // Example 1: Context-bound action on selected table rows                                                                                                                                                                                             
       * // Use case: Approve multiple purchase orders                                                                                                                                                                                                         
       * const aSelectedContexts = oTable.getSelectedContexts();                                                                                                                                                                                               
       * const aResults = await ODataV4Library.executeActionForContexts(                                                                                                                                                                                       
       *     aSelectedContexts,                                                                                                                                                                                                                                
       *     "ApprovePurchaseOrder",                                                                                                                                                                                                                           
       *     oModel,                                                                                                                                                                                                                                           
       *     { approver: "John Doe", comment: "Approved" }                                                                                                                                                                                                     
       * );                                                                                                                                                                                                                                                    
       * console.log(`Approved ${aResults.length} orders`);                                                                                                                                                                                                    
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // Example 2: Static action for file download                                                                                                                                                                                                         
       * // Use case: Download Excel template                                                                                                                                                                                                                  
       * const oResult = await ODataV4Library.executeActionForContexts(                                                                                                                                                                                        
       *     null,                                                                                                                                                                                                                                             
       *     "DownloadAssetTemplate",                                                                                                                                                                                                                          
       *     oModel,                                                                                                                                                                                                                                           
       *     { templateType: "Asset" },                                                                                                                                                                                                                        
       *     true // Mark as static action                                                                                                                                                                                                                     
       * );                                                                                                                                                                                                                                                    
       * // oResult contains: { AssetFileName, AssetFileContent, AssetMimeType }                                                                                                                                                                               
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // Example 3: Static action for file upload                                                                                                                                                                                                           
       * // Use case: Upload Excel file with 10,000+ rows                                                                                                                                                                                                      
       * const oResult = await ODataV4Library.executeActionForContexts(                                                                                                                                                                                        
       *     null,                                                                                                                                                                                                                                             
       *     "UploadAssetFileContent",                                                                                                                                                                                                                         
       *     oModel,                                                                                                                                                                                                                                           
       *     { AssetFileContent: base64Data },                                                                                                                                                                                                                 
       *     "true" // String "true" also works                                                                                                                                                                                                                
       * );                                                                                                                                                                                                                                                    
       *                                                                                                                                                                                                                                                       
       * @example                                                                                                                                                                                                                                              
       * // Example 4: Error handling                                                                                                                                                                                                                          
       * try {                                                                                                                                                                                                                                                 
       *     oView.setBusy(true);                                                                                                                                                                                                                              
       *     const aResults = await ODataV4Library.executeActionForContexts(                                                                                                                                                                                   
       *         aSelectedContexts,                                                                                                                                                                                                                            
       *         "DeleteRecords",                                                                                                                                                                                                                              
       *         oModel                                                                                                                                                                                                                                        
       *     );                                                                                                                                                                                                                                                
       *     MessageToast.show(`Deleted ${aResults.length} records`);                                                                                                                                                                                          
       * } catch (oError) {                                                                                                                                                                                                                                    
       *     console.error("Delete failed:", oError);                                                                                                                                                                                                          
       * } finally {                                                                                                                                                                                                                                           
       *     oView.setBusy(false);                                                                                                                                                                                                                             
       *     ODataV4Library.clearModelCache(); // Clean up                                                                                                                                                                                                     
       * }                                                                                                                                                                                                                                                     
       *                                                                                                                                                                                                                                                       
       * @param {sap.ui.model.odata.v4.Context[]} [aContexts=null] - Array of contexts from selected table rows. Pass null for static actions.                                                                                                                 
       * @param {string} sActionName - OData action name (e.g., "ApprovePurchaseOrder", "DownloadTemplate"). Do NOT include leading slash.                                                                                                                     
       * @param {sap.ui.model.odata.v4.ODataModel} oBindingModel - The OData V4 model instance from your view.                                                                                                                                                 
       * @param {object} [oParameters=null] - Action parameters as key-value pairs (e.g., { fileType: "PDF", language: "EN" }).                                                                                                                                
       * @param {boolean|string} [bIsStaticAction=false] - Set to true or "true" for static (unbound) actions. False for context-bound actions.                                                                                                                
       * @returns {Promise<any[]|any>} Promise resolving to:                                                                                                                                                                                                   
       *   - Array of result objects for context-bound actions (one per context)                                                                                                                                                                               
       *   - Single result object for static actions                                                                                                                                                                                                           
       *   - Empty array if no contexts provided                                                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      executeActionForContexts: async function (                                                                                                                                                                                                               
        aContexts,                                                                                                                                                                                                                                             
        sActionName,                                                                                                                                                                                                                                           
        oBindingModel,                                                                                                                                                                                                                                         
        oParameters,                                                                                                                                                                                                                                           
        bIsStaticAction                                                                                                                                                                                                                                        
      ) {                                                                                                                                                                                                                                                      
        // Normalize action name: remove leading '/' if present                                                                                                                                                                                                
        sActionName = sActionName.startsWith('/') ? sActionName.substring(1) : sActionName;                                                                                                                                                                    
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                               
        const bStatic =                                                                                                                                                                                                                                        
          bIsStaticAction === true || String(bIsStaticAction) === "true";                                                                                                                                                                                      
        // Handle static (unbound) actions                                                                                                                                                                                                                     
        if (bStatic) {                                                                                                                                                                                                                                         
          return this._executeStaticAction(                                                                                                                                                                                                                    
            sActionName,                                                                                                                                                                                                                                       
            oBindingModel,                                                                                                                                                                                                                                     
            oParameters                                                                                                                                                                                                                                        
          );                                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        const oModel =                                                                                                                                                                                                                                         
          oBindingModel ||                                                                                                                                                                                                                                     
          (aContexts && aContexts.length > 0 && aContexts[0].getModel());                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (!oModel) {                                                                                                                                                                                                                                         
          const sError = "OData model could not be determined for the action.";                                                                                                                                                                                
          MessageBox.error(sError);                                                                                                                                                                                                                            
          throw new Error(sError);                                                                                                                                                                                                                             
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
          // Use the model's default batch group. All invoke calls are automatically added to this group                                                                                                                                                       
          const sGroupId = "$auto"; // Recommended default group for automatic batching                                                                                                                                                                        
          return await this._executeStandardBatch(                                                                                                                                                                                                             
            aContexts,                                                                                                                                                                                                                                         
            sActionName,                                                                                                                                                                                                                                       
            oModel,                                                                                                                                                                                                                                            
            oParameters,                                                                                                                                                                                                                                       
            sGroupId                                                                                                                                                                                                                                           
          );                                                                                                                                                                                                                                                   
        } catch (oError) {                                                                                                                                                                                                                                     
          const sMessage =                                                                                                                                                                                                                                     
            oError.message ||                                                                                                                                                                                                                                  
            "An unknown error occurred during the batch operation.";                                                                                                                                                                                           
          MessageBox.error(sMessage);                                                                                                                                                                                                                          
          throw oError; // Re-throw to allow the caller to handle it, e.g., to stop a busy indicator                                                                                                                                                           
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Executes a standard OData action in a batch for multiple contexts.                                                                                                                                                                                    
       *&nbsp;                                                                                                                                                                                                                                                 
       * This method processes multiple contexts in a single $batch request for optimal performance.                                                                                                                                                           
       * All actions are executed in parallel and results are collected using Promise.allSettled.                                                                                                                                                              
       *&nbsp;                                                                                                                                                                                                                                                 
       * Behavior:                                                                                                                                                                                                                                             
       * - Successful actions: Results are returned in the array                                                                                                                                                                                               
       * - Failed actions: Errors are logged and shown in MessageBox, but don't stop other actions                                                                                                                                                             
       * - Empty contexts: Returns empty array immediately                                                                                                                                                                                                     
       *&nbsp;                                                                                                                                                                                                                                                 
       * @private                                                                                                                                                                                                                                              
       * @param {sap.ui.model.odata.v4.Context[]} aContexts - Array of contexts to process.                                                                                                                                                                    
       * @param {string} sActionName - OData action name without leading slash.                                                                                                                                                                                
       * @param {sap.ui.model.odata.v4.ODataModel} oModel - The OData V4 model.                                                                                                                                                                                
       * @param {object} oParameters - Action parameters as key-value pairs.                                                                                                                                                                                   
       * @param {string} sGroupId - Batch group ID (typically "$auto" for automatic batching).                                                                                                                                                                 
       * @returns {Promise<any[]>} Array of successful results. Failed actions are excluded but logged.                                                                                                                                                        
       */                                                                                                                                                                                                                                                      
      _executeStandardBatch: async function (                                                                                                                                                                                                                  
        aContexts,                                                                                                                                                                                                                                             
        sActionName,                                                                                                                                                                                                                                           
        oModel,                                                                                                                                                                                                                                                
        oParameters,                                                                                                                                                                                                                                           
        sGroupId                                                                                                                                                                                                                                               
      ) {                                                                                                                                                                                                                                                      
        // Early return for empty contexts to avoid unnecessary processing                                                                                                                                                                                     
        if (!aContexts || aContexts.length === 0) {                                                                                                                                                                                                            
          return [];                                                                                                                                                                                                                                           
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        // Keep input contexts alive during batch operation                                                                                                                                                                                                    
        if (bSupportsKeepAlive) {                                                                                                                                                                                                                              
          aContexts.forEach((oContext) => {                                                                                                                                                                                                                    
            if (oContext.setKeepAlive) {                                                                                                                                                                                                                       
              oContext.setKeepAlive(true);                                                                                                                                                                                                                     
            }                                                                                                                                                                                                                                                  
          });                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
          // 1. Create an array of promises for each action call.                                                                                                                                                                                              
          const aActionPromises = aContexts.map(async (oContext) => {                                                                                                                                                                                          
            const sPath = oContext.getPath();                                                                                                                                                                                                                  
            const oActionBinding = oModel.bindContext(                                                                                                                                                                                                         
              `${sPath}/${sActionName}(...)`,                                                                                                                                                                                                                  
              undefined,                                                                                                                                                                                                                                       
              { $$groupId: sGroupId }                                                                                                                                                                                                                          
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
              // Set parameters for the action if provided.                                                                                                                                                                                                    
              if (oParameters) {                                                                                                                                                                                                                               
                Object.entries(oParameters).forEach(([key, value]) => {                                                                                                                                                                                        
                  oActionBinding.setParameter(key, value);                                                                                                                                                                                                     
                });                                                                                                                                                                                                                                            
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              // Invoke the action and return a promise that resolves with the result object                                                                                                                                                                   
              // Reference:                                                                                                                                                                                                                                    
              //    https://sapui5.hana.ondemand.com/#/api/sap.ui.model.odata.v4.ODataContextBinding%23methods/invoke                                                                                                                                          
              // Use the determined invocation method (invoke or execute)                                                                                                                                                                                      
              // The `fnInvokeAction` variable is set once when the module loads, holding either "invoke" or "execute".                                                                                                                                        
              await oActionBinding[fnInvokeAction]();                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
              const oResultContext = oActionBinding.getBoundContext();                                                                                                                                                                                         
              if (bSupportsKeepAlive && oResultContext.setKeepAlive) {                                                                                                                                                                                         
                oResultContext.setKeepAlive(true);                                                                                                                                                                                                             
              }                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
              try {                                                                                                                                                                                                                                            
                return oResultContext.getObject();                                                                                                                                                                                                             
              } finally {                                                                                                                                                                                                                                      
                if (bSupportsKeepAlive && oResultContext.setKeepAlive) {                                                                                                                                                                                       
                  oResultContext.setKeepAlive(false);                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
              }                                                                                                                                                                                                                                                
            } finally {                                                                                                                                                                                                                                        
              // Destroy binding to prevent memory leak                                                                                                                                                                                                        
              oActionBinding.destroy();                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
          });                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
          // 2. Submit the batch group. This sends all queued requests to the backend in a single $batch request.                                                                                                                                              
          await oModel.submitBatch(sGroupId);                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
          // 3. Wait for all individual action promises to complete and process the results.                                                                                                                                                                   
          const aAllSettledResults = await Promise.allSettled(aActionPromises);                                                                                                                                                                                
                                                                                                                                                                                                                                                               
          // 4. Separate successful results from failures for better handling by the caller.                                                                                                                                                                   
          const aSuccessfulResults = [];                                                                                                                                                                                                                       
          const aFailedReasons = [];                                                                                                                                                                                                                           
          aAllSettledResults.forEach((oResult) => {                                                                                                                                                                                                            
            if (oResult.status === "fulfilled") {                                                                                                                                                                                                              
              aSuccessfulResults.push(oResult.value);                                                                                                                                                                                                          
            } else {                                                                                                                                                                                                                                           
              // The error object is in oResult.reason                                                                                                                                                                                                         
              const oError = oResult.reason;                                                                                                                                                                                                                   
              const sErrorMessage = oError.message || "Unknown error";                                                                                                                                                                                         
              console.error("An action in the batch failed:", oError);                                                                                                                                                                                         
              aFailedReasons.push(sErrorMessage); // Push the message string                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
          });                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
          // Return only successful results for backward compatibility, but log if there were failures.                                                                                                                                                        
          if (aFailedReasons.length > 0) {                                                                                                                                                                                                                     
            const sErrorDetails = aFailedReasons.join("\n");                                                                                                                                                                                                   
            MessageBox.error(                                                                                                                                                                                                                                  
              `Batch operation completed with ${aFailedReasons.length} failure(s):\n\n${sErrorDetails}`                                                                                                                                                        
            );                                                                                                                                                                                                                                                 
          }                                                                                                                                                                                                                                                    
          return aSuccessfulResults; // Or return { successful: aSuccessfulResults, failed: aFailedReasons } for more detailed handling.                                                                                                                       
        } finally {                                                                                                                                                                                                                                            
          // Release input contexts after batch operation completes                                                                                                                                                                                            
          if (bSupportsKeepAlive) {                                                                                                                                                                                                                            
            aContexts.forEach((oContext) => {                                                                                                                                                                                                                  
              if (oContext.setKeepAlive) {                                                                                                                                                                                                                     
                oContext.setKeepAlive(false);                                                                                                                                                                                                                  
              }                                                                                                                                                                                                                                                
            });                                                                                                                                                                                                                                                
          }                                                                                                                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Executes a static (unbound) OData action.                                                                                                                                                                                                             
       *&nbsp;                                                                                                                                                                                                                                                 
       * This method is optimized for long-running operations like file uploads/downloads.                                                                                                                                                                     
       * It uses a dedicated model with:                                                                                                                                                                                                                       
       * - $direct group: Sends request immediately without batching                                                                                                                                                                                           
       * - Model caching: Reuses model for subsequent calls to same service                                                                                                                                                                                    
       * - Extended timeout: Prevents 504 errors for operations taking >5 minutes                                                                                                                                                                              
       *&nbsp;                                                                                                                                                                                                                                                 
       * Use cases:                                                                                                                                                                                                                                            
       * - File downloads (Excel, PDF templates)                                                                                                                                                                                                               
       * - File uploads (large Excel files with 10,000+ rows)                                                                                                                                                                                                  
       * - Bulk operations (delete all records, refresh data)                                                                                                                                                                                                  
       * - Report generation                                                                                                                                                                                                                                   
       *&nbsp;                                                                                                                                                                                                                                                 
       * @private                                                                                                                                                                                                                                              
       * @param {string} sActionName - OData action name without leading slash (e.g., "DownloadTemplate").                                                                                                                                                     
       * @param {sap.ui.model.odata.v4.ODataModel} oBindingModel - The OData V4 model from your view.                                                                                                                                                          
       * @param {object} oParameters - Action parameters (e.g., { AssetFileContent: base64Data }).                                                                                                                                                             
       * @returns {Promise<any>} Single result object from the action (e.g., { FileName, FileContent, MimeType }).                                                                                                                                             
       */                                                                                                                                                                                                                                                      
      _executeStaticAction: async function (                                                                                                                                                                                                                   
        sActionName,                                                                                                                                                                                                                                           
        oBindingModel,                                                                                                                                                                                                                                         
        oParameters                                                                                                                                                                                                                                            
      ) {                                                                                                                                                                                                                                                      
        if (!oBindingModel) {                                                                                                                                                                                                                                  
          const sError = "No binding model provided for static action.";                                                                                                                                                                                       
          MessageBox.error(sError);                                                                                                                                                                                                                            
          throw new Error(sError);                                                                                                                                                                                                                             
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        const sUrl = oBindingModel.getServiceUrl();                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        // For long-running static actions, it's best to create a dedicated model                                                                                                                                                                              
        // with specific timeout headers to avoid interfering with other app requests.                                                                                                                                                                         
        // We use a cache to reuse this dedicated model for subsequent calls.                                                                                                                                                                                  
        const sCacheKey = `${sUrl}_long_runner_${iCustomTimeout}`;                                                                                                                                                                                             
        let oLongRunnerModel = oModelCache.get(sCacheKey);                                                                                                                                                                                                     
        if (!oLongRunnerModel) {                                                                                                                                                                                                                               
          oLongRunnerModel = new ODataModelV4({                                                                                                                                                                                                                
            serviceUrl: sUrl,                                                                                                                                                                                                                                  
            synchronizationMode: "None",                                                                                                                                                                                                                       
            operationMode: "Server",                                                                                                                                                                                                                           
            earlyRequests: true,                                                                                                                                                                                                                               
            httpHeaders: {                                                                                                                                                                                                                                     
              "sap-contextid-accept": "header",                                                                                                                                                                                                                
              "sap-cancel-on-close": "true",                                                                                                                                                                                                                   
            },                                                                                                                                                                                                                                                 
          });                                                                                                                                                                                                                                                  
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                   
          // Apply custom timeout to prevent 504 Gateway Timeout                                                                                                                                                                                               
          if (iCustomTimeout > 0) {                                                                                                                                                                                                                            
            oLongRunnerModel.sDefaultUpdateGroupId = "$direct";                                                                                                                                                                                                
            oLongRunnerModel.iRequestTimeout = iCustomTimeout;                                                                                                                                                                                                 
          }                                                                                                                                                                                                                                                    
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                   
          oModelCache.set(sCacheKey, oLongRunnerModel);                                                                                                                                                                                                        
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        // IMPORTANT: The action binding must be created on the model that has the headers.                                                                                                                                                                    
        const oDataModel = oLongRunnerModel;                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        // For a static (unbound) action, the binding path must start with a '/'                                                                                                                                                                               
        // Use $direct group to send request immediately without batching (better for long operations)                                                                                                                                                         
        const oActionBinding = oDataModel.bindContext(                                                                                                                                                                                                         
          `/${sActionName}(...)`,                                                                                                                                                                                                                              
          undefined,                                                                                                                                                                                                                                           
          {                                                                                                                                                                                                                                                    
            $$groupId: "$direct", //"$auto"                                                                                                                                                                                                                    
          }                                                                                                                                                                                                                                                    
        );                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Set parameters for the action if provided.                                                                                                                                                                                                          
        if (oParameters) {                                                                                                                                                                                                                                     
          // Use Object.entries for a more modern and declarative approach                                                                                                                                                                                     
          Object.entries(oParameters).forEach(([key, value]) => {                                                                                                                                                                                              
            oActionBinding.setParameter(key, value);                                                                                                                                                                                                           
          });                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
          // Invoke the action and return a promise that resolves with the result object                                                                                                                                                                       
          // Reference:                                                                                                                                                                                                                                        
          //    https://sapui5.hana.ondemand.com/#/api/sap.ui.model.odata.v4.ODataContextBinding%23methods/invoke                                                                                                                                              
          // Use the determined invocation method (invoke or execute)                                                                                                                                                                                          
          // The `fnInvokeAction` variable is set once when the module loads, holding either "invoke" or "execute".&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                
          await oActionBinding[fnInvokeAction]();                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
          const oResultContext = oActionBinding.getBoundContext();                                                                                                                                                                                             
          if (bSupportsKeepAlive && oResultContext.setKeepAlive) {                                                                                                                                                                                             
            oResultContext.setKeepAlive(true);                                                                                                                                                                                                                 
          }                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
          try {                                                                                                                                                                                                                                                
            return oResultContext.getObject();                                                                                                                                                                                                                 
          } finally {                                                                                                                                                                                                                                          
            if (bSupportsKeepAlive && oResultContext.setKeepAlive) {                                                                                                                                                                                           
              oResultContext.setKeepAlive(false);                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
          }                                                                                                                                                                                                                                                    
        } finally {                                                                                                                                                                                                                                            
          // Destroy binding to prevent memory leak                                                                                                                                                                                                            
          oActionBinding.destroy();                                                                                                                                                                                                                            
        }                                                                                                                                                                                                                                                      
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Sets custom timeout for OData requests (useful for backend debugging).                                                                                                                                                                                
       *&nbsp;                                                                                                                                                                                                                                                 
       * Default timeout is 30 minutes (1800000ms).                                                                                                                                                                                                            
       * Set to 0 for no timeout (not recommended for production).                                                                                                                                                                                             
       *&nbsp;                                                                                                                                                                                                                                                 
       * @example                                                                                                                                                                                                                                              
       * // For backend debugging - set very long timeout                                                                                                                                                                                                      
       * ODataV4Library.setTimeout(3600000); // 1 hour                                                                                                                                                                                                         
       *&nbsp;                                                                                                                                                                                                                                                 
       * @example                                                                                                                                                                                                                                              
       * // For production - set reasonable timeout                                                                                                                                                                                                            
       * ODataV4Library.setTimeout(300000); // 5 minutes                                                                                                                                                                                                       
       *&nbsp;                                                                                                                                                                                                                                                 
       * @param {number} iTimeout - Timeout in milliseconds                                                                                                                                                                                                    
       * @public                                                                                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      setTimeout: function (iTimeout) {                                                                                                                                                                                                                        
        iCustomTimeout = iTimeout;                                                                                                                                                                                                                             
        oModelCache.clear();                                                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Gets current timeout setting.                                                                                                                                                                                                                         
       *&nbsp;                                                                                                                                                                                                                                                 
       * @returns {number} Current timeout in milliseconds                                                                                                                                                                                                     
       * @public                                                                                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      getTimeout: function () {                                                                                                                                                                                                                                
        return iCustomTimeout;                                                                                                                                                                                                                                 
      },                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
      /**                                                                                                                                                                                                                                                      
       * Clears the internal model cache to free memory.                                                                                                                                                                                                       
       *&nbsp;                                                                                                                                                                                                                                                 
       * Call this method after completing operations to prevent memory leaks,                                                                                                                                                                                 
       * especially when working with large files or multiple service calls.                                                                                                                                                                                   
       *&nbsp;                                                                                                                                                                                                                                                 
       * Best practice: Call in finally block after action execution.                                                                                                                                                                                          
       *&nbsp;                                                                                                                                                                                                                                                 
       * @example                                                                                                                                                                                                                                              
       * try {                                                                                                                                                                                                                                                 
       *     await ODataV4Library.executeActionForContexts(...);                                                                                                                                                                                               
       * } finally {                                                                                                                                                                                                                                           
       *     ODataV4Library.clearModelCache();                                                                                                                                                                                                                 
       * }                                                                                                                                                                                                                                                     
       *&nbsp;                                                                                                                                                                                                                                                 
       * @public                                                                                                                                                                                                                                               
       */                                                                                                                                                                                                                                                      
      clearModelCache: function () {                                                                                                                                                                                                                           
        oModelCache.clear();                                                                                                                                                                                                                                   
      },                                                                                                                                                                                                                                                       
    };                                                                                                                                                                                                                                                         
  }                                                                                                                                                                                                                                                            
);                                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               