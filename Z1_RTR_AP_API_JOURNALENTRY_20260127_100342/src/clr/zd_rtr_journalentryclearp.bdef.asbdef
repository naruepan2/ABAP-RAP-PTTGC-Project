abstract;
strict ( 2 );
with hierarchy;

define behavior for ZD_RTR_JournalEntryClearP alias JournalEntryClear with control
{
  field ( suppress )
  Dummy1;

  field ( mandatory:execute )
  CompanyCode,
  AccountingDocumentType,
  DocumentDate,
  PostingDate,
  CurrencyCode;

  association _APARClear ;
  association _GLClear ;
  association _Item ;
}

define behavior for ZD_RTR_JEClearPostItem alias PostItem
{
  field ( suppress )
  Dummy1,
  Dummy2;

  association _Parent;
}

define behavior for ZD_RTR_JournalEntryClearAPAR alias ClearAPAR
{

  field ( suppress )
  Dummy1,
  Dummy2;

  association _Parent;
  association _Document;
}

define behavior for ZD_RTR_JEClearAPARDocument alias ClearAPARDocument
{
  field ( suppress )
  Dummy2,
  Dummy3;

  association _Parent;
}

define behavior for ZD_RTR_JournalEntryClearGL alias ClearGL
{

  field ( suppress )
  Dummy1,
  Dummy2;

  association _Parent;
  association _Document;

}

define behavior for ZD_RTR_JEClearGLDocument alias ClearGLDocument
{
  field ( suppress )
  Dummy2,
  Dummy3;

  association _Parent;
}